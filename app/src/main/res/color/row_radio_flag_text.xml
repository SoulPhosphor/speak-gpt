<?xml version="1.0" encoding="utf-8"?>
<!-- Voice-input option label: the theme's error color while the option is
     flagged (activated) as selected but not yet usable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorError" android:state_activated="true" />
    <item android:color="?attr/appRowTitleColor" />
</selector>
