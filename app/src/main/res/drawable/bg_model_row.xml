<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected row in the model and TTS model lists. Transparent fill, which
     the list adapters used to produce by tinting the shared
     btn_accent_tonal_selector_v3 from code. -->
<ripple android:color="?attr/colorSecondaryContainer"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</ripple>
