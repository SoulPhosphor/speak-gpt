<?xml version="1.0" encoding="utf-8"?>
<!-- Owner design, Aug 16 2026: filled with the same colorSurfaceContainerHigh
     tone as the active prompt tab (PromptTabBackground), so the selected tab
     visually reads as continuing into this box rather than being a separate
     bright accent block. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
    <corners android:radius="4dp" />
</shape>
