<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <stroke
                android:width="@dimen/quick_settings_segment_stroke_width"
                android:color="?attr/colorOutlineVariant" />
            <corners
                android:topLeftRadius="@dimen/quick_settings_segment_outer_radius"
                android:topRightRadius="@dimen/quick_settings_segment_outer_radius"
                android:bottomLeftRadius="@dimen/quick_settings_segment_inner_radius"
                android:bottomRightRadius="@dimen/quick_settings_segment_inner_radius" />
        </shape>
    </item>
</ripple>
