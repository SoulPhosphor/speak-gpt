<?xml version="1.0" encoding="utf-8"?>
<!-- The top 1dp overlay removes the popup's upper stroke. Together with
     bg_dropdown_open_anchor this creates one uninterrupted outer border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/appDropdownBackgroundColor" />
            <stroke android:width="1dp" android:color="?attr/appDropdownBorderColor" />
            <corners android:bottomLeftRadius="5dp" android:bottomRightRadius="5dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appDropdownBackgroundColor" />
        </shape>
    </item>
</layer-list>
