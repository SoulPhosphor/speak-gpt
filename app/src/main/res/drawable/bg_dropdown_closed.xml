<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appDropdownBackgroundColor" />
            <stroke android:width="1dp" android:color="?attr/appDropdownDisabledBorderColor" />
            <corners android:radius="@dimen/dropdown_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/appDropdownBackgroundColor" />
            <stroke android:width="1dp" android:color="?attr/appDropdownBorderColor" />
            <corners android:radius="@dimen/dropdown_corner_radius" />
        </shape>
    </item>
</selector>
