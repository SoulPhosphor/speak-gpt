<!-- Alert state of the summarizer error count badge (owner ruling, Aug 31
     2026): a white circle with a red ring and a red number. Deliberately fixed
     colors, not theme attributes, so an unacknowledged failure is unmistakable
     in every theme — the neutral, acknowledged state uses bg_summarizer_badge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="1.5dp"
        android:color="@color/light_red" />
</shape>
