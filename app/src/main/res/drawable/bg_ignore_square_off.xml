<?xml version="1.0" encoding="utf-8"?>
<!-- Unmarked state of the provider chart's Ignore control: an empty outlined
     square (house 4dp corners) in the muted text color. Pairs with
     bg_ignore_square_on for the marked state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/appSubtleTextColor" />
    <corners android:radius="4dp" />
</shape>
