<?xml version="1.0" encoding="utf-8"?>
<!-- Level-4 tonal surface with the shared 12dp button corner. Fill of the
     tonal icon-button backgrounds. One place to recolor. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/surface_level4_overlay" />
        </shape>
    </item>
</layer-list>
