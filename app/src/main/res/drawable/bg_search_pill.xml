<?xml version="1.0" encoding="utf-8"?>
<!-- Widget.App.SearchPill: one fully rounded outline around a search scope
     dropdown and its search field. Theme colors only. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/search_pill_stroke_width"
        android:color="?attr/colorOutline" />
    <corners android:radius="@dimen/search_pill_corner_radius" />
</shape>
