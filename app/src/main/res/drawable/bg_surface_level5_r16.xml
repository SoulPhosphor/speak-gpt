<?xml version="1.0" encoding="utf-8"?>
<!-- Level-5 tonal surface, 16dp corners (inactive Settings tile, Android 12+). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/surface_level5_overlay" />
        </shape>
    </item>
</layer-list>
