    <string name="summarizer_err_access_rejected">The selected AI service rejected access. Check the endpoint\'s API key, authentication mode, and model access.</string>
    <string name="summarizer_err_model_unavailable_title">Model Unavailable</string>
    <string name="summarizer_err_model_unavailable">The selected AI service couldn\'t use the Summary Model. Check the model name and access, or choose another model in Summarizer Settings.</string>
