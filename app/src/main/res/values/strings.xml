    <string name="memory_search_test_settings_hint">These numbers decide which memories are sent. Changes are tried in the test above right away. Chats keep using the saved numbers until you tap Use in Chats.</string>
    <string name="memory_search_minimum_match">Minimum Match</string>
    <string name="memory_search_minimum_match_info">How closely a memory\'s meaning must match your message before it can be sent. Higher sends fewer memories.</string>
    <string name="memory_search_stand_out">Stand-Out Strength</string>
    <string name="memory_search_stand_out_info">How far a memory\'s match must stand above your other memories. This keeps loosely related memories out, such as every personal memory when you are upset about something else. Higher sends fewer memories.</string>
    <string name="memory_search_keyword_match">Keyword Match Needed</string>
    <string name="memory_search_keyword_match_info">How much of your message a memory\'s keywords must cover to send it on keywords alone. Rare words such as names count the most, and common words never count. Higher sends fewer memories.</string>
    <string name="memory_search_importance">Importance Influence</string>
    <string name="memory_search_importance_info">How much a memory\'s importance rating can move it up or down among memories that already match. It never lets an unrelated memory in.</string>
    <string name="memory_search_max_memories">Maximum Memories</string>
    <string name="memory_search_max_memories_subtitle">The most memories sent with one message. A matching +3 memory is still added when this is full.</string>
    <string name="memory_search_memory_space">Memory Space</string>
    <string name="memory_search_memory_space_subtitle">The most characters of memory text sent with one message.</string>
    <string name="memory_search_section_advanced">Advanced</string>
    <string name="memory_search_advanced_hint">Fine adjustments. Most people never need to change these.</string>
    <string name="memory_search_small_library">Small Library Size</string>
    <string name="memory_search_small_library_subtitle">When fewer memories than this can be searched, there are too few to compare, so only Small Library Minimum Match is used.</string>
    <string name="memory_search_small_library_match">Small Library Minimum Match</string>
    <string name="memory_search_small_library_match_info">The meaning match a memory needs when fewer memories than Small Library Size can be searched.</string>
    <string name="memory_search_full_strength">Full-Strength Match</string>
    <string name="memory_search_full_strength_info">The meaning match treated as a perfect match when putting memories in order.</string>
    <string name="memory_search_agreement">Agreement Bonus</string>
    <string name="memory_search_agreement_info">Extra weight for a memory that matches by both meaning and keywords.</string>
    <string name="memory_search_min_spread">Minimum Spread</string>
    <string name="memory_search_min_spread_info">Keeps tiny differences from looking important when your memories are very similar to each other.</string>
