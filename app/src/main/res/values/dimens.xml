    <dimen name="conversation_mode_selector_choice_min_width">104dp</dimen>
    <dimen name="conversation_mode_selector_choice_padding">22dp</dimen>
    <!-- The vertical gap that separates the Zone 2 sections on every roleplay
         card (character, NPC, world, campaign share view_card_section). One
         place to tune the line spacing for all of them (owner ask, July 10
         2026 — "a variable that's the same"). -->
    <dimen name="card_section_gap">12dp</dimen>

    <dimen name="button_corner_radius">4dp</dimen>

    <!-- Companion prompt tab file-tab shape (PromptTabBackground): the fixed
         diagonal-cut width on each tab's trailing edge, and the outline
         stroke width matching the app's other 1dp outlined boxes. -->
    <dimen name="prompt_tab_slant_width">10dp</dimen>
    <dimen name="prompt_tab_stroke_width">1dp</dimen>

    <!-- Widget.App.Row.ProfileImage's leading preview size (profile-images-plan.md). -->
    <dimen name="row_profile_image_size">48dp</dimen>

    <!-- Shared BlurView radius for the composer action pop-ups. Kept outside
         ChatActivity so appearance work can tune both menus centrally. -->
    <dimen name="chat_action_menu_blur_radius">16dp</dimen>

    <!-- Current adaptable chat presentation geometry. These values match the
         owner-approved visual target tuned on Aug 13 2026. -->
    <dimen name="chat_message_speaker_inset">25dp</dimen>
    <dimen name="chat_message_ai_right_inset">28dp</dimen>
    <dimen name="chat_message_user_left_inset">49dp</dimen>
    <dimen name="chat_message_content_padding">14dp</dimen>
    <!-- The tuner gives every message 22dp of leading space and exposes the
         trailing 22dp as its message-gap control. Keeping them separate
         preserves the tuner's vertical rhythm instead of halving it. -->
    <dimen name="chat_message_leading_spacing">22dp</dimen>
    <dimen name="chat_message_unit_spacing">22dp</dimen>

    <dimen name="chat_portrait_size">96dp</dimen>
    <!-- Bubble-side edge 25dp plus the tuned -8dp outward portrait offset. -->
    <dimen name="chat_portrait_edge_inset">17dp</dimen>
    <!-- Portrait overlaps 20dp above the bubble; the 22dp leading space
         keeps the portrait inside the message item's bounds. -->
    <dimen name="chat_portrait_top_offset">-20dp</dimen>
    <!-- No whole-block top clearance: PortraitAwareMessageTextView handles the
         early-line inset so later lines reclaim the full reading width. -->
    <dimen name="chat_portrait_vertical_offset">0dp</dimen>
    <dimen name="chat_portrait_text_clearance">0dp</dimen>
    <!-- Horizontal breathing room between the portrait and the text it
         clears (owner ask, Aug 14 2026: the first pass hugged too tight). -->
    <dimen name="chat_portrait_text_gap">9dp</dimen>
    <dimen name="chat_portrait_name_gap">14dp</dimen>

    <!-- Name begins/ends 102dp inward from the tuned 25dp bubble edge. -->
    <dimen name="chat_name_portrait_edge_inset">127dp</dimen>
    <dimen name="chat_name_portrait_top">10dp</dimen>
    <!-- Body starts 9dp below the measured name bottom: the tuned spacing plus
         the final requested 2dp of extra breathing room. -->
    <dimen name="chat_name_body_gap">9dp</dimen>
    <!-- No-portrait, bubble-OFF name placement only. Untouched (owner ask,
         Aug 14 2026). With a painted bubble the name instead aligns with the
         message content (one content-padding in), computed in ChatAdapter. -->
    <dimen name="chat_name_bubble_edge_offset">1dp</dimen>
