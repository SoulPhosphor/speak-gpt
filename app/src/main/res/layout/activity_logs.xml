<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Search panel: declared before the header so the header draws over
         it while it slides down from behind (LogSearchBar). Searches only
         this log. -->
    <LinearLayout
        android:id="@+id/log_search_panel"
        style="@style/Widget.App.ActionBar.SearchPanel"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.SearchPill.InPanel">

            <ImageView
                style="@style/Widget.App.SearchPill.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/log_search_field"
                style="@style/Widget.App.SearchPill.Field"
                android:layout_weight="1"
                android:hint="@string/hint_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Header with trailing icons: Search is always last; the Voice Debug
         log's jump to Advanced Voice settings chains before it (hidden on
         every other log, where the title then ends at Search). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_logs_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/title_logs"
            app:layout_constraintEnd_toStartOf="@+id/btn_voice_advanced" />

        <!-- One-tap jump to the advanced voice & debugging screen, shown only on
             the Event log (set in LogsActivity) so the user can read what's
             wrong and then go straight to the knobs that fix it. Same icon as
             that tile. -->
        <ImageButton
            android:id="@+id/btn_voice_advanced"
            style="@style/Widget.App.ActionBar.ChainedButton"
            android:contentDescription="@string/btn_open_voice_advanced"
            android:src="@drawable/ic_terminal"
            android:tooltipText="@string/btn_open_voice_advanced"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btn_log_search"
            app:srcCompat="@drawable/ic_terminal" />

        <ImageButton
            android:id="@+id/btn_log_search"
            style="@style/Widget.App.ActionBar.SecondaryButton"
            android:contentDescription="@string/hint_search"
            android:src="@drawable/ic_search"
            android:tooltipText="@string/hint_search" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Clear (left) and Copy / Export (right) share one line. Clear uses the
         destructive semantic style, Copy the primary style; the side-by-side
         placement is local layout only. Copy sits on the right so the user can
         hand the log off (paste to a developer or coding bot) before wiping it
         with Clear. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_clear_log"
        style="@style/AppButton.Destructive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="24dp"
        android:paddingVertical="16dp"
        android:text="@string/btn_clear_log"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_copy_log"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copy_log"
        style="@style/AppButton.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="24dp"
        android:paddingVertical="16dp"
        android:text="@string/btn_copy_log"
        app:layout_constraintBottom_toBottomOf="@+id/btn_clear_log"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_clear_log"
        app:layout_constraintTop_toTopOf="@+id/btn_clear_log" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_clear_log"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/log_search_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Log ordering control. A toggle-row line (title + switch, no
                 subtitle) that scrolls away with the log rather than pinning to
                 the top. On = newest entry first (the default); the choice is
                 remembered app-wide. -->
            <LinearLayout
                android:id="@+id/row_newest_first"
                style="@style/Widget.App.Row.Toggle"
                android:layout_marginHorizontal="24dp">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        android:id="@+id/newest_first_title"
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/logs_newest_first" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_newest_first"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <!-- One view_log_entry per log entry, built by LogsActivity. -->
            <LinearLayout
                android:id="@+id/log_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>