<?xml version="1.0" encoding="utf-8"?>
<!-- Restore Options: simple screen header (ui-style-guide.md). ScreenChrome
     colors it and joins it to the top edge of the screen. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">
        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />
        <TextView
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/restore_options_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout style="@style/Widget.App.Page.Content">
            <!-- ============ Restore Data ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/restore_data_section" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/restore_data_hint" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/restore_chat_always_newer" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/restore_chat_always_newer_desc" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_restore_chat_always_newer"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/restore_chat_keep_both" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_restore_chat_keep_both"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_activation_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_profile_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_chats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_companions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_generated_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_glamours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_lorebooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_memories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_model_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/restore_model_credentials_note"
                style="@style/Widget.App.Section.Hint"
                android:text="@string/restore_model_credentials_note" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_model_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_roleplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_system_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_portable_restore"
                style="@style/AppButton.Primary.Inline.Centered" android:text="@string/restore_from_backup" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/restore_type_label" />

                <TextView
                    android:id="@+id/btn_restore_type"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_restore_database"
                style="@style/AppButton.Primary.Inline.Centered" android:text="@string/restore_database" />

            <LinearLayout android:id="@+id/restore_progress"
                style="@style/Widget.App.Page.ControlRow" android:visibility="gone">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/restore_spinner" style="@style/Widget.Material3.CircularProgressIndicator.ExtraSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView android:id="@+id/restore_progress_text"
                        style="@style/Widget.App.Row.Subtitle" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
