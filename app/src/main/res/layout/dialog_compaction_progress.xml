<?xml version="1.0" encoding="utf-8"?>
<!-- Compact progress (owner rulings, Oct 4 and Nov 2 2026): title with the
     real percentage done, a bar showing it, and "Processing Conversation
     History" with three looping dots, "Using Summarizer Model: <model>"
     beneath it, plus a single Cancel. After success
     the status reads "Compaction complete!" with Cancel (undo the
     compaction) and Okay. Styles: Widget.App.ProgressDialog.* -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.ProgressDialog.Content">

        <LinearLayout style="@style/Widget.App.ProgressDialog.HeaderRow">

            <TextView
                android:id="@+id/compaction_title"
                style="@style/Widget.App.ProgressDialog.Title"
                android:text="@string/compaction_dialog_title" />

            <TextView
                android:id="@+id/compaction_percent"
                style="@style/Widget.App.ProgressDialog.Percent" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/compaction_progress"
            style="@style/Widget.App.ProgressDialog.Bar" />

        <LinearLayout style="@style/Widget.App.ProgressDialog.StatusRow">

            <TextView
                android:id="@+id/compaction_status"
                style="@style/Widget.App.ProgressDialog.Status"
                android:text="@string/compaction_dialog_processing" />

            <TextView
                android:id="@+id/compaction_dots"
                style="@style/Widget.App.ProgressDialog.Dots" />
        </LinearLayout>

        <TextView
            android:id="@+id/progress_dialog_model"
            style="@style/Widget.App.ProgressDialog.Model" />
    </LinearLayout>

    <include layout="@layout/dialog_single_action" />

    <include layout="@layout/dialog_two_actions_cancel_first" />

</LinearLayout>
