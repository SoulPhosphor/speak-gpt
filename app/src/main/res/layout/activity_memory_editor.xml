<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/mem_edit_title_new"
            app:layout_constraintEnd_toStartOf="@+id/btn_header_save" />

        <ImageButton
            android:id="@+id/btn_header_save"
            style="@style/Widget.App.ActionBar.SaveButton"
            android:contentDescription="@string/btn_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/btn_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                style="@style/Widget.App.Field.Label.PageTop"
                android:labelFor="@+id/field_mem_content"
                android:text="@string/mem_edit_label_content" />

            <FrameLayout style="@style/Widget.App.Field.ExpandableBox">

                <EditText
                    android:id="@+id/field_mem_content"
                    style="@style/Widget.App.Field.ExpandableBox.Input"
                    android:importantForAutofill="no" />

                <ImageButton
                    android:id="@+id/btn_expand_content"
                    style="@style/Widget.App.Field.ExpandableBox.Toggle" />
            </FrameLayout>

            <TextView
                style="@style/Widget.App.Field.Label.PageTop"
                android:labelFor="@+id/field_mem_title"
                android:text="@string/memory_browser_title_label" />

            <TextView
                style="@style/Widget.App.Field.Hint"
                android:text="@string/memory_browser_title_hint" />

            <EditText
                android:id="@+id/field_mem_title"
                style="@style/Widget.App.Field.Box.MemoryTitle"
                android:inputType="textCapSentences|textMultiLine"
                android:importantForAutofill="no" />

            <!-- Scope, Type and Importance (owner order, Nov 3 2026): each
                 label has its information icon right after it and the
                 dropdown fills the rest of the line. -->
            <LinearLayout style="@style/Widget.App.Page.ControlRow">

                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/mem_edit_label_scope" />

                <ImageButton
                    android:id="@+id/btn_info_scope"
                    style="@style/Widget.App.InfoButton" />

                <TextView
                    android:id="@+id/btn_mem_scope"
                    style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill" />
            </LinearLayout>

            <!-- Target picker (owner rework, July 8–9 2026): "Associated
                 <Scope>" label + a boxed dropdown on the SAME line (the box
                 wraps the dropdown only, 5dp corners — never the whole line,
                 never pills). Selections appear below as small-curve boxes
                 with an × at the far right to remove; multiple go across. -->
            <LinearLayout
                android:id="@+id/section_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_targets_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/dropdown_targets"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dropdown_box"
                        android:drawableEnd="@drawable/ic_arrow_drop_down"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="10dp"
                        android:text="@string/mem_dropdown_select"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Persistent inline note (owner ruling, July 9 2026): an
                 untargeted roleplay draft "Needs roleplay target." — it
                 cannot be linked to a card until a target is assigned via
                 the picker above. Never a vanishing message. -->
            <TextView
                android:id="@+id/text_needs_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mem_needs_roleplay_target"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout style="@style/Widget.App.Page.ControlRow">

                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/mem_edit_label_type" />

                <ImageButton
                    android:id="@+id/btn_info_type"
                    style="@style/Widget.App.InfoButton" />

                <TextView
                    android:id="@+id/btn_mem_type"
                    style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_importance"
                style="@style/Widget.App.Page.ControlRow">

                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/mem_edit_label_importance" />

                <ImageButton
                    android:id="@+id/btn_info_importance"
                    style="@style/Widget.App.InfoButton" />

                <TextView
                    android:id="@+id/btn_mem_importance"
                    style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill" />
            </LinearLayout>

            <!-- Roleplay drafts only (owner design, July 8 2026 evening):
                 "Link to Lore Card:" — picking a card + section here makes
                 Approve All As Shown MOVE the memory onto that card instead
                 of activating it (it leaves the browser and lives with the
                 card). Label + boxed dropdown share the line; the box wraps
                 the dropdown only (5dp corners). -->
            <LinearLayout
                android:id="@+id/section_link_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mem_edit_link_card_label"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/dropdown_link_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dropdown_box"
                        android:drawableEnd="@drawable/ic_arrow_drop_down"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="10dp"
                        android:text="@string/mem_dropdown_select"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mem_add_card_section_label"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/dropdown_link_section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dropdown_box"
                        android:drawableEnd="@drawable/ic_arrow_drop_down"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="10dp"
                        android:text="@string/mem_dropdown_select"
                        android:textColor="@color/text_title"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedDenseStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/mem_edit_hint_tags">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_mem_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mem_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:text="@string/mem_edit_btn_save" />

            <!-- The bottom Save / Approve All As Shown button above and this Accept
                 button are hidden (owner ruling, Nov 3 2026): the header save
                 icon saves. Their wiring stays for later use. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mem_accept"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="@string/mem_edit_accept" />
        </LinearLayout>
    </ScrollView>

    <!-- Expanded Memory box: fills the page below the header. -->
    <FrameLayout
        android:id="@+id/panel_content_expanded"
        style="@style/Widget.App.Field.ExpandedPanel.Holder"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <FrameLayout style="@style/Widget.App.Field.ExpandedPanel">

            <EditText
                android:id="@+id/field_mem_content_expanded"
                style="@style/Widget.App.Field.ExpandedPanel.Input"
                android:contentDescription="@string/mem_edit_label_content"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btn_collapse_content"
                style="@style/Widget.App.Field.ExpandedPanel.Toggle" />
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
