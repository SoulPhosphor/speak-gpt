<!--
  Full-screen lorebook editor (owner ruling, Aug 3 2026: the old pop-up became
  a full screen with the shared house header). The title carries the book's
  name ("Edit {name}") or reads "Create Lorebook" for a new book. Save (disk)
  and, when editing, Delete (trashcan) live in the header; there is no bottom
  button row. The name/description/tag fields are the pre-existing content,
  carried over unchanged pending a separate content pass.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/title_create_lorebook"
            app:layout_constraintEnd_toStartOf="@+id/btn_delete" />

        <!-- Chains off btn_save (the edge-anchored icon), so it uses
             ChainedButton rather than SecondaryButton (which bakes in the
             end-of-parent anchor). Hidden for a brand-new book (nothing to
             delete yet), shown by EditLoreBookActivity when editing. -->
        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/Widget.App.ActionBar.ChainedButton"
            android:contentDescription="@string/label_delete_lorebook"
            android:src="@drawable/ic_delete"
            android:tooltipText="@string/label_delete_lorebook"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btn_save"
            app:srcCompat="@drawable/ic_delete" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/Widget.App.ActionBar.SecondaryButton"
            android:contentDescription="@string/btn_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/btn_save"
            app:srcCompat="@drawable/ic_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Name: Title / Subtext / Box, matching the Companion editor's
                 shared field styles. text_field_name_error is a persistent
                 inline error (house rule: field errors on the input itself,
                 never a toast/dialog) shown by EditLoreBookActivity.save() when
                 the name is empty. -->
            <TextView
                android:id="@+id/label_field_name"
                style="@style/Widget.App.Field.Label"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_name_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/hint_field_name"
                style="@style/Widget.App.Field.Hint"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_name_help"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_field_name" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_name"
                style="@style/Widget.App.Field.Box"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hint_field_name" />

            <TextView
                android:id="@+id/text_field_name_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/field_name" />

            <!-- Description: Title / Subtext / Box. -->
            <TextView
                android:id="@+id/label_field_description"
                style="@style/Widget.App.Field.Label"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_description_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_field_name_error" />

            <TextView
                android:id="@+id/hint_field_description"
                style="@style/Widget.App.Field.Hint"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_description_help"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_field_description" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_description"
                style="@style/Widget.App.Field.Box"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hint_field_description" />

            <!-- Tag: Title / Subtext / Box. -->
            <TextView
                android:id="@+id/label_field_tag"
                style="@style/Widget.App.Field.Label"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_tag_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/field_description" />

            <TextView
                android:id="@+id/hint_field_tag"
                style="@style/Widget.App.Field.Hint"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:text="@string/lorebook_tag_help"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_field_tag" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_tag"
                style="@style/Widget.App.Field.Box"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hint_field_tag" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
