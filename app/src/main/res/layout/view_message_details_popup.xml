<!--
  The anchored Message Details popup opened by the ⓘ message action
  (chat-redesign-plan.md §5). Every color resolves through a theme attribute
  (the rounded surface fill lives in @drawable/ui_dialog_rounded, text uses the
  shared appTitleTextColor / appSubtleTextColor / appTextColor zone roles), so a
  future palette or theme applies here without touching this layout. Each field
  row is shown only when that field has a stored value; the empty line covers a
  message saved before any details were recorded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_dialog_rounded"
    android:minWidth="220dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/details_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_details_title"
        android:textColor="?attr/appTitleTextColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/details_row_datetime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_details_datetime"
            android:textColor="?attr/appSubtleTextColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/details_value_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/appTextColor"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/details_row_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_details_model"
            android:textColor="?attr/appSubtleTextColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/details_value_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/appTextColor"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/details_row_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_details_tokens"
            android:textColor="?attr/appSubtleTextColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/details_value_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/appTextColor"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/details_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/message_details_empty"
        android:textColor="?attr/appSubtleTextColor"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
