<?xml version="1.0" encoding="utf-8"?>
<!-- Column headings of a token usage chart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Usage.TableHeader">

    <TextView
        style="@style/Widget.App.Usage.TableHeaderLabel"
        android:text="@string/usage_column_usage" />
    <TextView
        style="@style/Widget.App.Usage.TableHeaderQuantity"
        android:text="@string/usage_column_tokens" />
    <TextView
        style="@style/Widget.App.Usage.TableHeaderCost"
        android:text="@string/usage_column_cost" />
</LinearLayout>
