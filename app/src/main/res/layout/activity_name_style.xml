<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/name_style_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        style="@style/Widget.App.NameStyle.Scroll"
        app:layout_constraintBottom_toTopOf="@id/name_style_save_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <!-- Each dropdown row is the shared canonical labeled row: label and
             control on one line, the control filling the rest of the width. -->
        <LinearLayout
            android:id="@+id/name_style_content"
            style="@style/Widget.App.NameStyle.Content">

            <include
                android:id="@+id/row_type"
                layout="@layout/view_memory_filter_dropdown" />

            <include
                android:id="@+id/row_name"
                layout="@layout/view_memory_filter_dropdown" />

            <LinearLayout style="@style/Widget.App.NameStyle.SavedPanel">
                <TextView
                    android:id="@+id/saved_style_panel"
                    style="@style/Widget.App.NameStyle.SavedValues" />
                <!-- Intentional text-only button: no separate fill or outline. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_original"
                    style="@style/Widget.App.NameStyle.RestoreOriginal"
                    android:text="@string/name_style_restore_original" />
            </LinearLayout>

            <TextView
                style="@style/Widget.App.NameStyle.SectionLabel"
                android:text="@string/name_style_select_style" />

            <include
                android:id="@+id/row_font_size"
                layout="@layout/view_memory_filter_dropdown" />

            <include
                android:id="@+id/row_font_style"
                layout="@layout/view_memory_filter_dropdown" />

            <include
                android:id="@+id/row_font"
                layout="@layout/view_memory_filter_dropdown" />

            <TextView
                android:id="@+id/text_preview"
                style="@style/Widget.App.NameStyle.Preview" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/name_style_save_bar"
        style="@style/Widget.App.NameStyle.SaveBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_style"
            style="@style/Widget.App.NameStyle.SaveButton" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
