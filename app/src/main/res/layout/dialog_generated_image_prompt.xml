<?xml version="1.0" encoding="utf-8"?>
<!-- Generated-image provenance and its token-saving summary. The Image Prompt
     is immutable (changing it would make the transcript disagree with the
     request that produced the stored image). The Summarized Image Text is the
     short reminder the model receives each turn; it starts read-only and only
     becomes editable through Edit, so the user can revise what is sent without
     touching the original prompt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prompt_dialog_title"
            style="@style/Widget.App.Row.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/image_gen_prompt_title" />

        <ImageButton
            android:id="@+id/btn_prompt_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_close"
            android:tooltipText="@string/btn_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="380dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prompt_dialog_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextColor"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/summary_dialog_title"
                style="@style/Widget.App.Section.Title"
                android:text="@string/image_gen_summary_title" />

            <TextView
                android:id="@+id/summary_dialog_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/appTextColor"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/summary_dialog_field"
                style="@style/Widget.App.Field.Box"
                android:layout_marginTop="4dp"
                android:gravity="top"
                android:hint="@string/image_gen_summary_edit_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:overScrollMode="always"
                android:scrollbars="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_summary_cancel"
            style="@style/AppButton.Destructive.Inline"
            android:text="@string/btn_cancel"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_summary_edit"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/image_gen_summary_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_summary_save"
            style="@style/AppButton.Primary.Inline"
            android:layout_marginStart="8dp"
            android:text="@string/btn_save"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
