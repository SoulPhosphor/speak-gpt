<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_row"
    style="@style/Widget.App.VoiceBrowser.Row">
    <ImageView
        android:id="@+id/voice_selected"
        style="@style/Widget.App.VoiceBrowser.SelectedIcon"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- The gap before the text lives here as marginStart: voice_selected has no
         end constraint, so a marginEnd on the icon itself has no effect. -->
    <LinearLayout
        android:id="@+id/voice_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/voice_action"
        app:layout_constraintStart_toEndOf="@id/voice_selected"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/voice_name" style="@style/Widget.App.Row.Title" />
        <TextView android:id="@+id/voice_metadata" style="@style/Widget.App.Row.Subtitle" android:maxLines="2" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/voice_action"
        style="@style/Widget.App.VoiceBrowser.Action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
