<?xml version="1.0" encoding="utf-8"?>
<!--
  Compaction error pop-up actions (owner ruling, Oct 30 2026), beneath the
  dialog's message: one right-aligned row of Retry, Copy and Okay, with Okay
  dropping to the next line, still on the right, only when the row does not
  fit (the same wrapping row as the Summarizer Errors pop-up); then
  Summarizer Settings centered beneath it. Structure only; every appearance
  value comes from the Widget.App.Dialog.Actions styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Dialog.Actions">

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/Widget.App.Dialog.Actions.EndRow">

        <androidx.constraintlayout.helper.widget.Flow
            style="@style/Widget.App.Dialog.Actions.EndRowFlow"
            app:constraint_referenced_ids="btn_compaction_error_retry,btn_compaction_error_copy,btn_compaction_error_okay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_compaction_error_retry"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/btn_msg_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_compaction_error_copy"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/btn_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_compaction_error_okay"
            style="@style/AppButton.Destructive.Inline"
            android:text="@string/okay" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_compaction_error_settings"
        style="@style/AppButton.Primary.Inline.Centered.BelowDialogRow"
        android:text="@string/title_summarizer_settings" />
</LinearLayout>
