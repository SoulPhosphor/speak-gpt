<?xml version="1.0" encoding="utf-8"?>
<!-- One provider inside its model's card (Usage & Cost). Structure only;
     every visual value is in the Widget.App.Usage.* styles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Usage.Stack">

    <!-- Separates this provider from the one above; hidden on the first. -->
    <View
        android:id="@+id/provider_gap"
        style="@style/Widget.App.Usage.ProviderGap" />

    <LinearLayout style="@style/Widget.App.Usage.Stack">

        <LinearLayout style="@style/Widget.App.Usage.ProviderHeader">

            <LinearLayout style="@style/Widget.App.Usage.ProviderNameColumn">

                <TextView
                    android:id="@+id/provider_name"
                    style="@style/Widget.App.Usage.ProviderName" />

                <TextView
                    android:id="@+id/provider_meta"
                    style="@style/Widget.App.Usage.ProviderMeta" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Usage.ProviderTotalColumn">

                <TextView
                    android:id="@+id/provider_total_cost"
                    style="@style/Widget.App.Usage.ProviderTotal" />

                <TextView
                    style="@style/Widget.App.Usage.ProviderTotalLabel"
                    android:text="@string/usage_provider_total" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/usage_table"
            style="@style/Widget.App.Usage.Table">

            <include android:id="@+id/usage_table_header" layout="@layout/view_usage_table_header" />
            <include android:id="@+id/usage_input_row" layout="@layout/view_usage_table_row" />
            <include layout="@layout/view_usage_table_divider" />
            <include android:id="@+id/usage_output_row" layout="@layout/view_usage_table_row" />
            <include layout="@layout/view_usage_table_divider" />
            <include android:id="@+id/usage_cached_row" layout="@layout/view_usage_table_row" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cache_hit_rate_box"
            style="@style/Widget.App.Usage.CacheRate">

            <TextView
                style="@style/Widget.App.Usage.CacheRateLabel"
                android:text="@string/usage_cache_hit_rate" />

            <TextView
                android:id="@+id/cache_hit_rate"
                style="@style/Widget.App.Usage.CacheRateValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pricing_footer"
            style="@style/Widget.App.Usage.PricingFooter">

            <LinearLayout
                android:id="@+id/price_facts"
                style="@style/Widget.App.Usage.PriceFacts">

                <include android:id="@+id/price_input" layout="@layout/view_usage_price_fact" />
                <include android:id="@+id/price_output" layout="@layout/view_usage_price_fact" />
                <include android:id="@+id/price_cached" layout="@layout/view_usage_price_fact" />
            </LinearLayout>

            <TextView
                android:id="@+id/price_caption"
                style="@style/Widget.App.Usage.PriceCaption"
                android:text="@string/usage_price_per_million" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
