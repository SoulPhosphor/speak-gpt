<?xml version="1.0" encoding="utf-8"?>
<!-- Conversation preview (owner-approved design, Oct 4 2026): a nearly
     full-height, read-only view of the real conversation over the Summary
     screen, opened at a summary section's starting point. A small fixed
     header names what is being inspected; the double chevron (or a swipe
     down) closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/preview_title"
            style="@style/Widget.App.Section.Title"
            android:layout_width="0dp"
            android:text="@string/conversation_preview_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_close_preview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_close_preview"
            style="@style/Widget.App.QuickTile.EditButton"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/conversation_preview_close_desc"
            android:src="@drawable/ic_keyboard_double_arrow_down"
            android:tooltipText="@string/conversation_preview_close_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/preview_start_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/preview_title">

            <ImageView
                style="@style/Widget.App.SummarySection.Flag"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.App.Screen.Intro"
                    android:text="@string/conversation_preview_start" />

                <TextView
                    android:id="@+id/preview_start_time"
                    style="@style/Widget.App.Section.Hint"
                    android:paddingTop="0dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/preview_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
