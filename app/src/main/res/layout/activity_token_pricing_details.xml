<?xml version="1.0" encoding="utf-8"?>
<!-- Usage & Cost. Structure only; every visual value is in the
     Widget.App.Usage.* styles. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/usage_header"
        style="@style/Widget.App.Usage.Header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_bar"
            style="@style/Widget.App.Usage.HeaderBar">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/Widget.App.ActionBar.BackButton" />

            <TextView
                android:id="@+id/activity_title"
                style="@style/Widget.App.Usage.HeaderTitle"
                android:text="@string/usage_cost_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        style="@style/Widget.App.Usage.Scroll"
        app:layout_constraintTop_toBottomOf="@id/usage_header">

        <!-- The conversation total scrolls with the sections (owner ruling,
             Oct 9 2026); only the header bar stays fixed. -->
        <LinearLayout style="@style/Widget.App.Usage.Content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/usage_total_block"
                style="@style/Widget.App.Usage.TotalBlock">

                <TextView
                    android:id="@+id/conversation_total_label"
                    style="@style/Widget.App.Usage.TotalLabel"
                    android:text="@string/usage_conversation_total"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/conversation_total_cost"
                    style="@style/Widget.App.Usage.TotalCost"
                    app:layout_constraintTop_toBottomOf="@id/conversation_total_label" />

                <TextView
                    android:id="@+id/conversation_usage_meta"
                    style="@style/Widget.App.Usage.TotalMeta"
                    app:layout_constraintTop_toBottomOf="@id/conversation_total_cost" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/pricing_sections"
                style="@style/Widget.App.Usage.Sections" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
