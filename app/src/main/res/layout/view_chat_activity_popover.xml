<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat header background-work popover (owner design, Nov 18 2026): no buttons,
  one centered line per piece of work in progress. Structure only; every
  appearance value comes from the Widget.App.Chat.ActivityPopover styles.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Chat.ActivityPopover.Holder">

    <LinearLayout style="@style/Widget.App.Chat.ActivityPopover">

        <TextView
            android:id="@+id/activity_line_memory_scan"
            style="@style/Widget.App.Chat.ActivityPopover.Line" />

        <TextView
            android:id="@+id/activity_line_summarizing"
            style="@style/Widget.App.Chat.ActivityPopover.Line" />
    </LinearLayout>
</FrameLayout>
