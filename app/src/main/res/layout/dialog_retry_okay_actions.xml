<?xml version="1.0" encoding="utf-8"?>
<!--
  Retry and Okay for an error pop-up: a right-aligned DialogActionRow of two
  label-sized primary buttons (ui-style-guide.md, "Every pop-up button row
  uses DialogActionRow"). Set as the dialog's custom view, beneath its title
  and message. All appearance comes from the shared styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Dialog.Actions">

    <org.teslasoft.assistant.ui.widgets.DialogActionRow
        style="@style/Widget.App.Dialog.Actions.EndRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_retry"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/btn_msg_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_okay"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/okay" />

        <androidx.constraintlayout.helper.widget.Flow
            style="@style/Widget.App.Dialog.Actions.EndRowFlow"
            app:constraint_referenced_ids="btn_dialog_retry,btn_dialog_okay" />

    </org.teslasoft.assistant.ui.widgets.DialogActionRow>

</LinearLayout>
