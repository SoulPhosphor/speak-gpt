<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ui"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingTop="@dimen/chat_message_leading_spacing"
    android:paddingBottom="@dimen/chat_message_unit_spacing">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_message_user_left_inset"
        android:layout_marginEnd="@dimen/chat_message_speaker_inset"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bubble_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chat_portrait_vertical_offset"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bubble_out"
            android:gravity="end"
            android:orientation="vertical"
            android:padding="@dimen/chat_message_content_padding">

            <LinearLayout
                android:id="@+id/include_bookmarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/condensed_bookmark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/include_condensed_bookmark_desc"
                    android:src="@drawable/ic_bookmark_add"
                    android:tint="?attr/colorPrimary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/artifact_bookmark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/include_artifact_bookmark_desc"
                    android:src="@drawable/ic_bookmark"
                    android:tint="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <org.teslasoft.assistant.ui.chat.PortraitAwareMessageTextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="user"
                android:textColor="?attr/colorSurface"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include_bookmarks" />

            <LinearLayout
                android:id="@+id/image_frame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message">

                <ImageView
                    android:id="@+id/generated_image"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/assistant" />

                <LinearLayout
                    android:id="@+id/generated_image_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/image_gen_loading_result"
                        android:textColor="?attr/appTextColor" />
                </LinearLayout>

                <TextView
                    android:id="@+id/generated_image_error"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/image_gen_load_failed"
                    android:textColor="?attr/appTextColor"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/generated_image_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_image_prompt"
                        style="@style/AppButton.Primary.Inline"
                        android:text="@string/image_gen_prompt_action"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_image_download"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/image_gen_save_action"
                        android:src="@drawable/ic_download"
                        android:tooltipText="@string/image_gen_save_action"
                        android:visibility="gone" />

                    <!-- For a generated image the Share and Copy actions sit on
                         this same row as Prompt and Download, instead of on the
                         separate action bar below (owner ask, Aug 14 2026). The
                         action-bar Share/Copy are hidden for images; these
                         delegate to them so the behavior is identical. -->
                    <ImageButton
                        android:id="@+id/btn_image_share"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Share message"
                        android:src="@drawable/ic_share"
                        android:tooltipText="Share message"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_image_copy"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_copy"
                        android:src="@drawable/ic_copy"
                        android:tooltipText="@string/btn_copy"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/message_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_frame">

                <ImageButton
                    android:id="@+id/btn_details"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="@string/message_details_action"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_info"
                    android:tooltipText="@string/message_details_action"
                    app:srcCompat="@drawable/ic_info" />

                <!-- Derived indicator for Includes owned by earlier user
                     messages. ChatAdapter resets this on every bind so a
                     recycled row cannot inherit another message's paperclip. -->
                <ImageButton
                    android:id="@+id/btn_persistent_includes"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/message_includes_action"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_attach"
                    android:tooltipText="@string/message_includes_action"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_attach" />

                <ImageButton
                    android:id="@+id/btn_speak"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_speak"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_volume_up"
                    android:tooltipText="@string/btn_msg_speak"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_volume_up" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="Share message"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_share"
                    android:tooltipText="Share message"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_share" />

                <ImageButton
                    android:id="@+id/btn_retry"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_retry"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_retry"
                    android:tooltipText="@string/btn_msg_retry"
                    app:srcCompat="@drawable/ic_retry" />

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_copy"
                    android:descendantFocusability="blocksDescendants"
                    android:tooltipText="@string/btn_copy"
                    app:srcCompat="@drawable/ic_copy" />

                <ImageButton
                    android:id="@+id/btn_edit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_edit"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_edit"
                    android:tooltipText="@string/btn_msg_edit"
                    app:srcCompat="@drawable/ic_edit" />
            </LinearLayout>

            <!-- Record of what was attached to this message (document-includes-plan.md).
                 Ordered after Message Actions when the message has text; for an
                 attachment-only message, ChatAdapter moves this tray up to sit
                 directly under the identity row instead (chat-redesign-plan.md
                 §6.1). While nothing is attached it is GONE and collapses to a
                 zero-height point, so it never reserves space. -->
            <!-- No android:id here on purpose: an id on an <include> REPLACES the
                 included layout's root id, so the root keeps its own
                 @id/include_summary that ChatAdapter looks up. -->
            <include
                layout="@layout/view_include_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message_actions_row" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chat_name_portrait_top"
        android:layout_marginEnd="@dimen/chat_name_portrait_edge_inset"
        android:text="@string/chat_role_user"
        android:textColor="?attr/colorSurface"
        android:textSize="21sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Declared last so the 96dp portrait stays above the overlapping bubble,
         matching the tuner's portrait z-index. -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/chat_portrait_size"
        android:layout_height="@dimen/chat_portrait_size"
        android:layout_marginTop="@dimen/chat_portrait_top_offset"
        android:layout_marginEnd="@dimen/chat_portrait_edge_inset"
        android:background="@drawable/btn_accent_tonal"
        android:contentDescription="@null"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_user" />
</androidx.constraintlayout.widget.ConstraintLayout>
