<?xml version="1.0" encoding="utf-8"?>
<!-- BackUp Options: simple screen header (ui-style-guide.md). ScreenChrome
     colors it and joins it to the top edge of the screen. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">
        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />
        <TextView
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/backup_options_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout style="@style/Widget.App.Page.Content">
            <include layout="@layout/section_automatic_backups" />

            <!-- Recovery Backup (manual) -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_create_section" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/backup_create_hint" />

            <!-- Recovery Type summaries, same font as the section hint
                 (Widget.App.Section.Hint), text set in Kotlin from
                 recovery_type_summary_format + the SAME title/desc strings
                 the Recovery Backup screen's choice panel uses, so these can
                 never drift out of sync with the actual choice (owner
                 ruling, July 22 2026). -->
            <TextView
                android:id="@+id/text_recovery_type_protected_summary"
                style="@style/Widget.App.Section.Hint" />

            <TextView
                android:id="@+id/text_recovery_type_unencrypted_summary"
                style="@style/Widget.App.Section.Hint" />

            <!-- Recovery Type dropdown: Widget.App.Dropdown.* (owner ruling,
                 July 22 2026), same pattern as the Human-Readable Chat Backup
                 fields below. Picking a type here skips the separate choice
                 screen the "Create Recovery Backup" button used to open —
                 that screen now goes straight to the picked type's next step.
                 The selection is remembered across visits
                 (RecoveryBackupState.getLastRecoveryProtected/
                 setLastRecoveryProtected), the same way Backup Style and
                 Format below are. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/recovery_type_label" />
                <TextView
                    android:id="@+id/btn_recovery_type"
                    style="@style/Widget.App.Dropdown.CanonicalValue" />
            </LinearLayout>

            <!-- Portable recovery (format v2) entry — the owner-approved
                 Create Recovery Backup flow, now the ONLY manual backup control.
                 The installation-bound v1 controls (text_manual_location,
                 btn_change_manual_location, btn_create_backup) are HIDDEN (owner
                 ruling, July 22 2026, correction 1): kept in the tree so the
                 activity's existing bindings/logic still resolve, but never
                 shown. Do not un-hide without the owner's word. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_recovery"
                style="@style/AppButton.Primary.Inline.Centered"
                android:text="@string/recovery_create" />

            <TextView style="@style/Widget.App.Section.Title" android:text="@string/backup_readable_section" />
            <TextView style="@style/Widget.App.Section.Hint" android:text="@string/backup_readable_desc" />
            <TextView android:id="@+id/text_readable_last_success" style="@style/Widget.App.Section.Hint" android:visibility="gone" />
            <LinearLayout style="@style/Widget.App.Page.ControlRow">
                <TextView style="@style/Widget.App.Dropdown.CanonicalLabel" android:text="@string/backup_readable_scope_label" />
                <TextView android:id="@+id/btn_readable_scope" style="@style/Widget.App.Dropdown.CanonicalValue.Trailing" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Page.ControlRow">
                <TextView style="@style/Widget.App.Dropdown.CanonicalLabel" android:text="@string/backup_readable_format_label" />
                <TextView android:id="@+id/btn_readable_format" style="@style/Widget.App.Dropdown.CanonicalValue.Trailing" />
            </LinearLayout>
            <TextView style="@style/Widget.App.Section.Title" android:text="@string/backup_readable_content_include" />
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_activation_prompts" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_activation_prompts_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_activation_prompts" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_profile_images" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_profile_images_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_profile_images" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_chats" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_chats_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_chats" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/backup_readable_include_thinking" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_include_thinking" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/backup_readable_include_folders" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_include_folders" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_companions" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_companions_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_companions" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_generated_images" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_generated_images_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_generated_images" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_glamours" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_glamours_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_glamours" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_lorebooks" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_lorebooks_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_lorebooks" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_memories" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_memories_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_memories" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_model_settings" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_model_settings_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_model_settings" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_model_rules" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_model_rules_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_model_rules" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_roleplay" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_roleplay_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_roleplay" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_settings" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_settings_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_settings" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/restore_category_system_prompts" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/restore_category_system_prompts_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_readable_system_prompts" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_readable_create" style="@style/AppButton.Primary.Inline.Centered"
                android:text="@string/backup_readable_create" />
            <TextView android:id="@+id/text_readable_status" style="@style/Widget.App.Section.Hint"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
