<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">
        <TextView
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/backup_options_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout style="@style/Widget.App.Page.Content">
            <include layout="@layout/section_automatic_backups" />

            <!-- Recovery Backup (manual) -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_create_section" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/backup_create_hint" />

            <!-- Recovery Type summaries, same font as the section hint
                 (Widget.App.Section.Hint), text set in Kotlin from
                 recovery_type_summary_format + the SAME title/desc strings
                 the Recovery Backup screen's choice panel uses, so these can
                 never drift out of sync with the actual choice (owner
                 ruling, July 22 2026). -->
            <TextView
                android:id="@+id/text_recovery_type_protected_summary"
                style="@style/Widget.App.Section.Hint" />

            <TextView
                android:id="@+id/text_recovery_type_unencrypted_summary"
                style="@style/Widget.App.Section.Hint" />

            <!-- Recovery Type dropdown: Widget.App.Dropdown.* (owner ruling,
                 July 22 2026), same pattern as the Human-Readable Chat Backup
                 fields below. Picking a type here skips the separate choice
                 screen the "Create Recovery Backup" button used to open —
                 that screen now goes straight to the picked type's next step.
                 The selection is remembered across visits
                 (RecoveryBackupState.getLastRecoveryProtected/
                 setLastRecoveryProtected), the same way Backup Style and
                 Format below are. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/recovery_type_label" />
                <TextView
                    android:id="@+id/btn_recovery_type"
                    style="@style/Widget.App.Dropdown.CanonicalValue" />
            </LinearLayout>

            <!-- Portable recovery (format v2) entry — the owner-approved
                 Create Recovery Backup flow, now the ONLY manual backup control.
                 The installation-bound v1 controls (text_manual_location,
                 btn_change_manual_location, btn_create_backup) are HIDDEN (owner
                 ruling, July 22 2026, correction 1): kept in the tree so the
                 activity's existing bindings/logic still resolve, but never
                 shown. Do not un-hide without the owner's word. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_recovery"
                style="@style/AppButton.Primary.Inline.Centered"
                android:text="@string/recovery_create" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
