<?xml version="1.0" encoding="utf-8"?>
<!-- Memory Handling Preferences (memory plan Phase 2, D.12): how memories
     are archived or permanently deleted. Built from the shared simple screen
     header, Page.Content body and toggle-row pieces in ui-style-guide.md;
     later phases add their preferences to this page. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/title_memory_handling_preferences" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.Page.Content">

            <LinearLayout
                android:id="@+id/row_delete_moves_to_archived"
                style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:labelFor="@+id/switch_delete_moves_to_archived"
                        android:text="@string/memory_handling_delete_moves_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/memory_handling_delete_moves_subtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_delete_moves_to_archived"
                    style="@style/Widget.App.Row.Switch"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
