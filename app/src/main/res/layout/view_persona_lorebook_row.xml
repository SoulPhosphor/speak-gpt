<!-- One linked lorebook on Edit Companion. Appearance comes from the
     Widget.App.CompanionEditor.LoreBook* styles; this file holds structure only. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.CompanionEditor.LoreBookCard">

    <TextView
        android:id="@+id/row_book_name"
        style="@style/Widget.App.CompanionEditor.LoreBookName"
        app:layout_constraintBottom_toTopOf="@+id/row_book_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/row_btn_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/row_book_subtitle"
        style="@style/Widget.App.CompanionEditor.LoreBookDetails"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/row_btn_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/row_book_name" />

    <ImageButton
        android:id="@+id/row_btn_edit"
        style="@style/Widget.App.CompanionEditor.LoreBookAction"
        android:contentDescription="@string/label_edit_lorebook"
        android:src="@drawable/ic_settings"
        android:tooltipText="@string/label_edit_lorebook"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/row_btn_unlink"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/row_btn_unlink"
        style="@style/Widget.App.CompanionEditor.LoreBookAction"
        android:contentDescription="@string/btn_unlink_lorebook"
        android:src="@drawable/ic_link_off"
        android:tooltipText="@string/btn_unlink_lorebook"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/row_btn_delete"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/row_btn_delete"
        style="@style/Widget.App.CompanionEditor.LoreBookAction"
        android:contentDescription="@string/btn_delete_lorebook"
        android:src="@drawable/ic_delete"
        android:tooltipText="@string/btn_delete_lorebook"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
