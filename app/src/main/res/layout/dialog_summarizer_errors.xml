<?xml version="1.0" encoding="utf-8"?>
<!--
  Summarizer Errors dialog (conversation-summary-plan.md decision 16 +
  conversation-summary-errors.md §1): one status paragraph, then the chat's
  stored errors (newest first, at most five), then one action row: Copy
  (every listed error), Hide (every listed error) and Okay, side by side.
  Okay drops to the next line, right-aligned, only when the row does not
  fit (the first line's bias wins while everything fits). The entries
  are built by ChatActivity from the stored log.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/summarizer_errors_status"
                style="@style/Widget.App.Screen.Intro" />

            <LinearLayout
                android:id="@+id/summarizer_errors_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_summarizer_errors_copy,btn_summarizer_errors_hide,btn_summarizer_errors_okay"
            app:flow_firstHorizontalBias="0"
            app:flow_horizontalBias="0"
            app:flow_lastHorizontalBias="1"
            app:flow_horizontalGap="12dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_summarizer_errors_copy"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/summarizer_errors_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_summarizer_errors_hide"
            style="@style/AppButton.Destructive.Inline"
            android:text="@string/summarizer_errors_hide" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_summarizer_errors_okay"
            style="@style/AppButton.Destructive.Inline"
            android:text="@string/summarizer_errors_okay" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
