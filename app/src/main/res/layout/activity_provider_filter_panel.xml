<!-- Provider chart Filters panel (owner spec, Aug 2 2026). Slides in from the
     right like the Memory Filters panel and auto-applies by editing
     ProviderFilterState in place — but its internals use the app's proper
     shared styles (the memory panel's internals are known-wrong and are NOT
     copied): close-panel header (Title.LeftAligned + CloseButton), dropdown
     rows from the Widget.App.Dropdown family, plain no-background checkbox
     rows (Widget.App.CheckOption), and the shared destructive button for
     Reset Filters. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.LeftAligned"
            android:text="@string/provider_filters_title" />

        <ImageButton
            android:id="@+id/btn_close"
            style="@style/Widget.App.ActionBar.CloseButton"
            android:contentDescription="@string/provider_filters_close"
            android:tooltipText="@string/provider_filters_close" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp">

            <!-- Sort/filter dropdowns, in the owner's order. Each value view is
                 the tap target and opens an anchored ListPopupWindow, per the
                 shared dropdown pattern. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    style="@style/Widget.App.Dropdown.Label"
                    android:text="@string/provider_filter_price" />

                <TextView
                    android:id="@+id/value_price"
                    style="@style/Widget.App.Dropdown.Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    style="@style/Widget.App.Dropdown.Label"
                    android:text="@string/provider_filter_quantization" />

                <TextView
                    android:id="@+id/value_quantization"
                    style="@style/Widget.App.Dropdown.Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    style="@style/Widget.App.Dropdown.Label"
                    android:text="@string/provider_filter_latency" />

                <TextView
                    android:id="@+id/value_latency"
                    style="@style/Widget.App.Dropdown.Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    style="@style/Widget.App.Dropdown.Label"
                    android:text="@string/provider_filter_throughput" />

                <TextView
                    android:id="@+id/value_throughput"
                    style="@style/Widget.App.Dropdown.Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    style="@style/Widget.App.Dropdown.Label"
                    android:text="@string/provider_filter_uptime" />

                <TextView
                    android:id="@+id/value_uptime"
                    style="@style/Widget.App.Dropdown.Value" />
            </LinearLayout>

            <!-- Capability checkboxes: whole line toggles the box, but the rows
                 deliberately have NO background — normal options, not tiles. -->
            <LinearLayout
                android:id="@+id/row_tool_support"
                style="@style/Widget.App.CheckOption.Row"
                android:layout_marginTop="12dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_tool_support"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />

                <TextView
                    style="@style/Widget.App.CheckOption.Label"
                    android:text="@string/provider_filter_tool_support" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_implicit_caching"
                style="@style/Widget.App.CheckOption.Row">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_implicit_caching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />

                <TextView
                    style="@style/Widget.App.CheckOption.Label"
                    android:text="@string/provider_filter_implicit_caching" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_zdr"
                style="@style/Widget.App.CheckOption.Row">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_zdr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />

                <TextView
                    style="@style/Widget.App.CheckOption.Label"
                    android:text="@string/provider_filter_zdr" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_filters"
                style="@style/AppButton.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/provider_filter_reset" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
