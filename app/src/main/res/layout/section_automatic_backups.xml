<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.App.Section.Title"
        android:text="@string/backup_auto_section" />

    <TextView
        style="@style/Widget.App.Section.Hint"
        android:text="@string/backup_auto_hint" />

    <LinearLayout style="@style/Widget.App.Row.Toggle">

        <LinearLayout style="@style/Widget.App.Row.TextColumn">

            <TextView
                style="@style/Widget.App.Row.Title"
                android:text="@string/backup_auto_enable" />

            <TextView
                style="@style/Widget.App.Row.Subtitle"
                android:text="@string/backup_auto_enable_subtitle" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_backup"
            style="@style/Widget.App.Row.Switch" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.App.Page.ControlRow">
        <TextView
            style="@style/Widget.App.Dropdown.CanonicalLabel"
            android:text="@string/backup_auto_frequency_label" />
        <TextView
            android:id="@+id/btn_auto_frequency"
            style="@style/Widget.App.Dropdown.CanonicalValue.Trailing" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_auto_location"
        style="@style/Widget.App.Section.Hint"
        android:textIsSelectable="true" />
    <LinearLayout style="@style/Widget.App.Page.ControlRow">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/spinner_auto_status"
            style="@style/Widget.App.Restore.ProgressSpinner"
            android:indeterminate="true"
            android:visibility="gone" />
        <LinearLayout style="@style/Widget.App.Row.TextColumn">
            <TextView
                android:id="@+id/text_auto_status"
                style="@style/Widget.App.Row.Subtitle"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_change_auto_location"
        style="@style/AppButton.Primary.Inline.Centered"
        android:text="@string/backup_auto_change_location" />
</LinearLayout>
