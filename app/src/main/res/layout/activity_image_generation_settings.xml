<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" style="@style/Widget.App.ImageGeneration.Root">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/action_bar" style="@style/Widget.App.ActionBar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btn_back" style="@style/Widget.App.ActionBar.BackButton" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/activity_title" style="@style/Widget.App.ActionBar.Title" android:text="@string/title_image_generation" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView android:id="@+id/scroll" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/action_bar" style="@style/Widget.App.ImageGeneration.Scroll">
        <LinearLayout style="@style/Widget.App.ImageGeneration.Content">
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_enable_imagine" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_imagine_command" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_let_ai_create" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_ai_create_images" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout android:id="@+id/row_ask_before_creating" style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_ask_before_creating" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_ask_before_creating" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_delete_with_chat" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/image_gen_delete_with_chat_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_delete_images_with_chat" style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <TextView style="@style/Widget.App.Section.Title" android:text="@string/image_gen_options_title" />
            <LinearLayout android:id="@+id/row_image_service" style="@style/Widget.App.Row.WithSubtitle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_provider" />
                    <TextView android:id="@+id/text_image_service_value" style="@style/Widget.App.Row.Subtitle" android:text="@string/label_endpoint_none" />
                </LinearLayout>
                <ImageView style="@style/Widget.App.Row.Chevron" android:contentDescription="@string/image_gen_row_service" />
            </LinearLayout>
            <LinearLayout android:id="@+id/row_image_model" style="@style/Widget.App.Row.WithSubtitle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/image_gen_model" />
                    <TextView android:id="@+id/text_image_model_value" style="@style/Widget.App.Row.Subtitle" android:text="@string/label_endpoint_none" />
                </LinearLayout>
                <ImageView style="@style/Widget.App.Row.Chevron" android:contentDescription="@string/image_gen_row_model" />
            </LinearLayout>
            <TextView style="@style/Widget.App.Section.Hint" android:id="@+id/image_settings_status" />
            <LinearLayout style="@style/Widget.App.ImageGeneration.Options" android:id="@+id/image_model_options" />
            <com.google.android.material.button.MaterialButton style="@style/AppButton.Primary.Inline" android:id="@+id/image_settings_retry" android:text="@string/health_btn_retry" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
