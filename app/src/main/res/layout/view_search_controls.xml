<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_controls"
    style="@style/Widget.App.Page.Content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg_search"
        style="@style/Widget.App.Field.Box">
        <EditText
            android:id="@+id/field_search"
            style="@style/Widget.App.Bookmark.SearchField"
            android:hint="@string/hint_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        <ImageButton
            android:id="@+id/btn_search"
            style="@style/Widget.App.QuickTile.EditButton"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout style="@style/Widget.App.Row.Toggle">
        <LinearLayout style="@style/Widget.App.Row.TextColumn">
            <TextView
                style="@style/Widget.App.Row.Title"
                android:labelFor="@id/check_whole_words"
                android:text="@string/search_whole_words" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/check_whole_words"
            style="@style/Widget.App.Row.Switch"
            android:contentDescription="@string/search_whole_words"
            android:checked="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_case_row"
        style="@style/Widget.App.Row.Toggle"
        android:visibility="gone">
        <LinearLayout style="@style/Widget.App.Row.TextColumn">
            <TextView
                style="@style/Widget.App.Row.Title"
                android:labelFor="@id/check_match_case"
                android:text="@string/search_match_case" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/check_match_case"
            style="@style/Widget.App.Row.Switch"
            android:contentDescription="@string/search_match_case"
            android:checked="false" />
    </LinearLayout>
</LinearLayout>
