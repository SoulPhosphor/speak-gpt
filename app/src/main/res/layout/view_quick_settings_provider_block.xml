<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout android:id="@+id/experimental_parallel_summary"
        style="@style/Widget.App.QuickSettings.Segment.Standalone"
        android:clickable="true" android:focusable="true" android:visibility="gone">
        <LinearLayout style="@style/Widget.App.Row.TextColumn">
            <TextView style="@style/Widget.App.QuickSettings.ToggleRow.Title" android:text="@string/experimental_setup_parallel" />
            <TextView android:id="@+id/experimental_parallel_model_count" style="@style/Widget.App.Row.Subtitle" />
        </LinearLayout>
        <ImageView style="@style/Widget.App.Row.Chevron" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_select_model"
        style="@style/Widget.App.QuickSettings.Segment.Top"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/textView71"
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/label_ai_model"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_model"
            style="@style/Widget.App.QuickTile.Value"
            android:layout_width="0dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView71"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/provider_mode_tile"
        style="@style/Widget.App.QuickSettings.Segment.Middle"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_provider_label"
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/quick_provider_mode_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dropdown_provider_mode"
            style="@style/Widget.App.QuickTile.Value"
            android:layout_width="0dp"
            android:text="@string/choose_provider_routing_automatic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_edit_provider_routing"
            app:layout_constraintStart_toEndOf="@+id/text_provider_label"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hidden in Only mode, where the gear sits on the Provider row. -->
        <ImageView
            android:id="@+id/btn_edit_provider_routing"
            style="@style/Widget.App.QuickSettings.Gear"
            android:contentDescription="@string/quick_edit_provider_routing_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Provider: shown only while Provider Mode is Only. Lists the recent
         Only-mode providers for this model; the gear opens Choose Provider
         and replaces the Provider Mode row's gear while this row shows. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/provider_tile"
        style="@style/Widget.App.QuickSettings.Segment.Middle"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_provider_title"
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/quick_provider_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dropdown_provider"
            style="@style/Widget.App.QuickTile.Value"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_edit_provider_routing_only"
            app:layout_constraintStart_toEndOf="@+id/text_provider_title"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_edit_provider_routing_only"
            style="@style/Widget.App.QuickSettings.Gear"
            android:contentDescription="@string/quick_edit_provider_routing_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/row_reasoning"
        style="@style/Widget.App.QuickSettings.Segment.Middle"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/textView_reasoning_title"
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/reasoning_thinking_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_reasoning_effort"
            style="@style/Widget.App.QuickTile.Value"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView_reasoning_title"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/row_api_endpoint"
        style="@style/Widget.App.QuickSettings.Segment.Bottom">

        <TextView
            android:id="@+id/textView95"
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/quick_api_endpoint_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_host"
            style="@style/Widget.App.QuickTile.Value"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_edit_api_endpoint"
            app:layout_constraintStart_toEndOf="@+id/textView95"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_edit_api_endpoint"
            style="@style/Widget.App.QuickSettings.Gear"
            android:contentDescription="@string/quick_edit_api_endpoint_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
