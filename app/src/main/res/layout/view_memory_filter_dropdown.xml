<!-- One Memory Filters dropdown row: a bold label on the left and the current
     value on the right, using the shared Widget.App.Dropdown family (the same
     pattern the Provider Filters panel uses). The value is the tap target and
     opens an anchored ListPopupWindow. The row carries NO filled background —
     only the value's own tap ripple. The value overrides the style's 0dp width
     with an explicit weight so it fills the row inside this LinearLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/label"
        style="@style/Widget.App.Dropdown.Label" />

    <TextView
        android:id="@+id/value"
        style="@style/Widget.App.Dropdown.Value"
        android:layout_width="0dp"
        android:layout_weight="1" />
</LinearLayout>
