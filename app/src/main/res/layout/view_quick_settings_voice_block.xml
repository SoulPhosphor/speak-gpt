<?xml version="1.0" encoding="utf-8"?>
<!-- This chat's Always Speak Responses. A self-contained standalone segment;
     a fresh chat starts from the Settings default, and a change here stays
     with this chat only. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/row_chat_always_speak"
        style="@style/Widget.App.QuickSettings.Segment.Standalone">

        <TextView
            style="@style/Widget.App.QuickTile.Label"
            android:text="@string/always_speak_responses"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_chat_always_speak"
            style="@style/Widget.App.QuickSettings.Switch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
