<!-- Inline Creating Image row (image-generation-rebuild-plan.md §5
     progress experience): the visible in-chat status for a running
     generation, with its required Cancel action. Transient — never
     persisted; restored while the registry still holds the job. Container
     reuses the assistant bubble background; text uses the shared row
     typography; Cancel uses the shared destructive inline button, the
     same composition as the confirmation card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="32dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_in"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/progress_title"
            style="@style/Widget.App.Row.Title"
            android:text="@string/image_gen_creating_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_progress_cancel"
            style="@style/AppButton.Destructive.Inline"
            android:layout_marginTop="8dp"
            android:text="@string/btn_cancel" />
    </LinearLayout>
</LinearLayout>
