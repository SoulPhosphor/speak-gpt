<?xml version="1.0" encoding="utf-8"?>
<!--
  One line inside an "Includes" record: the file's type icon, name, explicit
  format, approximate token weight, and the sent-item three-dot menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/summary_item_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/include_icon_desc"
        android:src="@drawable/ic_file"
        android:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/summary_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/summary_item_format"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_subtitle"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/summary_item_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_subtitle"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/summary_item_action"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/include_menu_desc"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        android:tint="?attr/colorPrimary" />
</LinearLayout>
