<?xml version="1.0" encoding="utf-8"?>
<!-- Sent attachment details, existing actions menu, and direct removal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Include.Row">

    <ImageView
        android:id="@+id/summary_item_icon"
        style="@style/Widget.App.Include.Icon"
        android:contentDescription="@string/include_icon_desc"
        android:src="@drawable/ic_file" />

    <TextView
        android:id="@+id/summary_item_name"
        style="@style/Widget.App.Include.Name"
        android:gravity="start" />

    <TextView
        android:id="@+id/summary_item_format"
        style="@style/Widget.App.Include.Weight"
        android:gravity="start" />

    <TextView
        android:id="@+id/summary_item_weight"
        style="@style/Widget.App.Include.Weight"
        android:gravity="start" />

    <ImageButton
        android:id="@+id/summary_item_action"
        style="@style/Widget.App.Include.Action"
        android:contentDescription="@string/include_menu_desc"
        android:src="@drawable/ic_more_vert" />

    <ImageButton
        android:id="@+id/summary_item_remove"
        style="@style/Widget.App.Include.Action"
        android:src="@drawable/ic_close" />
</LinearLayout>
