<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in the Summarizer Errors dialog (conversation-summary-errors.md
  §1). The stored error detail uses the same shared body style as any other
  explanatory paragraph after a heading. Entries carry no buttons of their
  own; the dialog's single action row covers every entry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/summarizer_error_entry_text"
        style="@style/Widget.App.Section.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textIsSelectable="true" />
</LinearLayout>
