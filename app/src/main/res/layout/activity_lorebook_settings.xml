<!-- Lorebook Settings (owner request, Stage 2): the lorebook limits shared by
     typed sending, voice and resending (LorebookLimits). Shared styles only. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/title_lorebook_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.Page.Content">

            <LinearLayout style="@style/Widget.App.Row.Number">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/lorebook_settings_max_entries" />
                </LinearLayout>

                <EditText
                    android:id="@+id/field_lorebook_max_entries"
                    style="@style/Widget.App.Row.Number.Field"
                    android:contentDescription="@string/lorebook_settings_max_entries"
                    android:ems="2"
                    android:importantForAutofill="no"
                    android:maxLength="2" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/lorebook_settings_limit_characters" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/lorebook_settings_limit_characters_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_lorebook_limit_characters"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_lorebook_max_characters"
                style="@style/Widget.App.Row.Number"
                android:visibility="gone">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/lorebook_settings_max_characters" />
                </LinearLayout>

                <EditText
                    android:id="@+id/field_lorebook_max_characters"
                    style="@style/Widget.App.Row.Number.Field"
                    android:contentDescription="@string/lorebook_settings_max_characters"
                    android:ems="4"
                    android:importantForAutofill="no"
                    android:maxLength="4" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
