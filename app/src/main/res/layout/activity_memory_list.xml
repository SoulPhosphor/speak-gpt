<!-- Reusable scaffold for every Phase 5 memory-manager list screen
     (MemoryScreenActivity). The back arrow, title and (optional) action button
     sit in the bar; the search field, the three-dots filter button (browser
     only), and the "add" FAB are shown or hidden by the hosting screen. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_add"
        style="?attr/extendedFloatingActionButtonPrimaryStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:text="@string/btn_new_memory"
        android:tooltipText="@string/btn_new_memory"
        android:visibility="gone"
        app:elevation="6dp"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/title_memories"
            app:layout_constraintEnd_toStartOf="@+id/btn_embedding_warning" />

        <!-- Optional secondary action (e.g. the browser's Companions link). Sits
             left of the primary action; hidden unless the screen supplies an
             icon, in which case it collapses to a point next to btn_action. -->
        <ImageButton
            android:id="@+id/btn_embedding_warning"
            style="@style/Widget.App.ActionBar.ChainedButton.Primary"
            android:src="@drawable/ic_warning"
            android:contentDescription="@string/memory_embedding_warning"
            android:tooltipText="@string/memory_embedding_warning"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btn_action_secondary" />

        <ImageButton
            android:id="@+id/btn_action_secondary"
            style="@style/Widget.App.ActionBar.ChainedButton"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btn_icon_legend" />

        <ImageButton
            android:id="@+id/btn_icon_legend"
            style="@style/Widget.App.ActionBar.ChainedButton.Primary"
            android:src="@drawable/ic_map"
            android:contentDescription="@string/memory_browser_icon_legend"
            android:tooltipText="@string/memory_browser_icon_legend"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btn_action" />

        <ImageButton
            android:id="@+id/btn_action"
            style="@style/Widget.App.ActionBar.SecondaryButton"
            android:contentDescription="@string/memory_row_actions"
            android:src="@drawable/ic_settings"
            android:tooltipText="@string/memory_row_actions"
            android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tools line (owner design, Nov 3 2026; Memories | Pending words from
         the July 8 2026 two-mode design): the search toggle and filter menu
         on the right, the mode words on the left with the filtered icon
         after the current one, and the "N Memories Pending" count line under
         the words (hidden when none are pending). Only the memory browser
         opts in; other list screens keep this collapsed. -->
    <LinearLayout
        android:id="@+id/mode_toggle_container"
        style="@style/Widget.App.ListTools.Container"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <include layout="@layout/view_memory_selection_controls" />

        <LinearLayout style="@style/Widget.App.ListTools.Row">

            <TextView
                android:id="@+id/btn_mode_memories"
                style="@style/Widget.App.ListTools.ModeWord"
                android:text="@string/mem_mode_memories" />

            <ImageView
                android:id="@+id/filtered_memories"
                style="@style/Widget.App.ListTools.FilteredIcon" />

            <TextView android:id="@+id/mode_separator" style="@style/Widget.App.ListTools.ModeSeparator" />

            <TextView
                android:id="@+id/btn_mode_pending"
                style="@style/Widget.App.ListTools.ModeWord"
                android:text="@string/mem_mode_pending" />

            <ImageView
                android:id="@+id/filtered_pending"
                style="@style/Widget.App.ListTools.FilteredIcon" />

            <Space style="@style/Widget.App.ListTools.Spacer" />

            <ImageButton
                android:id="@+id/btn_search_toggle"
                style="@style/Widget.App.ListTools.Action"
                android:contentDescription="@string/memory_search_hint"
                android:src="@drawable/ic_search"
                android:tooltipText="@string/memory_search_hint" />

            <!-- Three-dots (vertical) filter button: opens the Memory Filters
                 slide-out panel. -->
            <ImageButton
                android:id="@+id/btn_filter"
                style="@style/Widget.App.ListTools.Action"
                android:contentDescription="@string/mem_filter_open"
                android:src="@drawable/ic_more_vert"
                android:tooltipText="@string/mem_filter_open"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/mode_pending_count"
            style="@style/Widget.App.ListTools.PendingCount"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:textColorHint="@color/memory_hint_soft"
        app:boxStrokeColor="@drawable/box_stroke_color"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:startIconDrawable="@drawable/ic_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mode_toggle_container">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/memory_search_hint"
            android:singleLine="true"
            android:textColorHint="@color/memory_hint_soft" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Legacy horizontal chip row (Stage 2.3). Replaced by the slide-out
         Memory Filters panel; kept in the layout in case another list screen
         wants a chip-style filter bar. Stays hidden unless a screen opts in. -->
    <HorizontalScrollView
        android:id="@+id/filter_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Pinned Pending-memories banner (Stage 2.4). Shown by the browser only
         when drafts exist; collapses when GONE. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/pending_banner"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:visibility="gone"
        app:icon="@drawable/ic_storage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filter_bar" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:paddingTop="48dp"
        android:text="@string/memory_list_empty"
        android:textColor="@color/text_subtitle"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pending_banner" />

    <ListView
        android:id="@+id/list_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pending_banner"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>
