<!-- Memory Controls: the normal user-facing controls page
     (memory_settings_reorg_spec.md §1, July 9 2026). Most-changed settings
     near the top, backups lower, the destructive Reset at the bottom. The
     Advanced Memory Settings door lives in the Memory Manager hub (its own row
     directly under Memory Controls), not here (owner ruling, July 9 2026). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/title_memory_controls"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                style="@style/Widget.App.Screen.Intro"
                android:paddingTop="16dp"
                android:text="@string/memory_controls_intro" />

            <!-- ============ Memory Defaults ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_controls_section_defaults" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_use_in_new_chats" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_use_in_new_chats_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.App.Row.Switch"
                    android:id="@+id/switch_default_memory" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_companion_roleplay" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_companion_roleplay_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.App.Row.Switch"
                    android:id="@+id/switch_companion_in_roleplay" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_chat_list_status" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_chat_list_status_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.App.Row.Switch"
                    android:id="@+id/switch_chat_list_memory_status" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_importance_ratings" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_importance_ratings_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_use_importance_ratings"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <!-- ============ Memory Engine ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_controls_section_engine" />

            <LinearLayout
                android:id="@+id/row_memory_engine"
                style="@style/Widget.App.Row.WithSubtitle"
                android:background="@null"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_row_engine" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_row_engine_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_memory_engine_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/memory_controls_engine_lorebooks" />
            </LinearLayout>

            <!-- Setup guidance (owner wording + placement, July 9 2026):
                 INLINE and persistent under the Memory Engine control —
                 never a toast. Shown when Full is refused for lack of an
                 embedding model; stays visible until the screen is left. -->
            <TextView
                android:id="@+id/text_engine_needs_model"
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_engine_needs_embedding"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- The Backups section and the destructive Reset section were moved
                 out of this screen into their own "Memory Backup & Restore" row
                 on the Memory Manager hub (owner request, July 18 2026). See
                 MemoryBackupRestoreActivity. -->
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
