<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Widget.App.Row.Title"
            android:text="@string/portable_chat_current_version" />

        <TextView
            android:id="@+id/chat_restore_current_title"
            style="@style/Widget.App.Row.Subtitle"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/chat_restore_current_details"
            style="@style/Widget.App.Row.Subtitle"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_preview_current"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/portable_chat_preview_current" />

        <TextView
            style="@style/Widget.App.Row.Title"
            android:layout_marginTop="16dp"
            android:text="@string/portable_chat_incoming_version" />

        <TextView
            android:id="@+id/chat_restore_incoming_title"
            style="@style/Widget.App.Row.Subtitle"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/chat_restore_incoming_details"
            style="@style/Widget.App.Row.Subtitle"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_preview_incoming"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/portable_chat_preview_incoming" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_keep_current"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/portable_chat_keep_current" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_use_incoming"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/portable_chat_use_incoming" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_keep_both_action"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/portable_chat_keep_both_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restore_cancel"
            style="@style/AppButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/portable_chat_cancel_restore" />
    </LinearLayout>
</ScrollView>
