<!-- Stage 6C: a Pending card's closest related memory (owner design,
     2026-11-22). Tapping the preview opens that exact pair in Possible Match
     Review; tapping Additional Matches opens Review at its additional matches.
     Hidden unless the suggestion has a Possible Match. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pending_related"
    style="@style/Widget.App.MemoryMatch.Related"
    android:visibility="gone">

    <TextView
        style="@style/Widget.App.MemoryMatch.Heading"
        android:text="@string/mem_match_related_header" />

    <TextView
        android:id="@+id/pending_related_preview"
        style="@style/Widget.App.MemoryMatch.Preview" />

    <TextView
        android:id="@+id/pending_related_detail"
        style="@style/Widget.App.MemoryMatch.Detail" />

    <TextView
        android:id="@+id/pending_related_additional"
        style="@style/Widget.App.MemoryMatch.Additional"
        android:visibility="gone" />
</LinearLayout>
