<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voice_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/model_unavailable_warning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/model_cleanup_unavailable"
            android:src="@drawable/ic_report"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorError" />

        <TextView
            android:id="@+id/voice_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/text"
            android:textSize="16sp"
            app:layout_goneMarginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_reasoning_settings"
            app:layout_constraintStart_toEndOf="@+id/model_unavailable_warning"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Reasoning lightbulb (chat-redesign-plan.md §7.4/§7.6). In the
             favorite list it is the actionable shortcut to Reasoning Settings;
             in View All it is a quieter, non-clickable "supports reasoning"
             indicator immediately to the left of the favorite/thumbs control.
             Each adapter sets visibility, clickability, and weight. -->
        <ImageButton
            android:id="@+id/btn_reasoning_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_parameters"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_lightbulb" />

        <!-- Model Parameters (Tune). Sits directly to the left of the routing
             gear and opens this favorite's saved sampling parameters. Shown for
             every favorite in the lists that show the gear (parameters apply to
             any model, unlike routing); GONE by default so other uses of this
             row are unchanged. -->
        <ImageButton
            android:id="@+id/btn_parameters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_routing_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_tune" />

        <!-- Provider-routing gear. Shown only for OpenRouter favorites
             (FavoriteModelListAdapter); a filled gear when routing is set up,
             an outline gear when it is not. Sits directly to the left of the
             remove (X) action. -->
        <ImageButton
            android:id="@+id/btn_routing_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_action"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_settings_outline" />

        <ImageButton
            android:id="@+id/btn_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@color/transparent"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_like" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
