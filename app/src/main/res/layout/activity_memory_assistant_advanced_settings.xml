<!-- Advanced Memory Assistant Settings: suggestion cap, endpoint/model
     selection, and AI extraction tuning (temperature, importance, prompt).
     Reached from the Memory Manager hub. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- This screen's title text is longer than any other simple header's,
             long enough to run under the back button when centered edge-to-edge
             like the shared style normally does. Reserves a margin on both
             sides matching the back button's own footprint (56dp) so the text
             never draws under it, and truncates instead of overlapping in the
             worst case. -->
        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:layout_width="0dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/title_memory_assistant_advanced"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                style="@style/Widget.App.Screen.Intro"
                android:paddingTop="16dp"
                android:text="@string/memory_assistant_adv_intro" />

            <!-- ============ Maximum Suggestions Per Conversation ============ -->
            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_max_suggestions" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_max_suggestions_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.App.Row.Switch"
                    android:id="@+id/switch_max_suggestions" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_max_suggestions"
                style="@style/Widget.App.Field.NumberBlank"
                android:layout_marginTop="8dp"
                android:ems="4"
                android:maxLength="4"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- ============ Memory Assistant Model ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_controls_section_assistant_model" />

            <LinearLayout
                android:id="@+id/row_archivist_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_row_assistant_endpoint" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_row_assistant_endpoint_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_archivist_endpoint_value"
                        style="@style/Widget.App.Dropdown.CanonicalValue"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/dropdown_select" />

                    <ImageButton
                        android:id="@+id/btn_edit_archivist_endpoint"
                        style="@style/Widget.App.QuickTile.EditButton"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="0dp"
                        android:contentDescription="@string/memory_assistant_edit_endpoint_desc"
                        android:src="@drawable/ic_settings"
                        android:tooltipText="@string/memory_assistant_edit_endpoint_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_archivist_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_controls_row_assistant_model" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_controls_row_assistant_model_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_archivist_model_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/dropdown_select" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_archivist_models"
                    style="@style/AppButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_provider_view_all_models" />
            </LinearLayout>

            <!-- OpenRouter-style provider routing is an override for Memory
                 Assistant only. It uses provider details already stored on the
                 selected favorite and is hidden for endpoints without routing. -->
            <LinearLayout
                android:id="@+id/section_archivist_routing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.App.Section.Title"
                    android:text="@string/memory_assistant_routing_title" />

                <TextView
                    style="@style/Widget.App.Section.Hint"
                    android:text="@string/memory_assistant_routing_hint" />

                <TextView
                    android:id="@+id/text_archivist_routing_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_provider_routing_automatic" />
            </LinearLayout>

            <!-- ============ Temperature ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_assistant_adv_temperature" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_temperature_value"
                    style="@style/Widget.App.Row.Title"
                    android:layout_width="wrap_content" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stepSize="0.1"
                android:valueFrom="0.0"
                android:valueTo="2.0" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_assistant_adv_temperature_recommended" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_assistant_adv_temperature_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_temperature"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/memory_assistant_adv_reset_temperature" />

            <!-- ============ Minimum Importance ============ -->
            <LinearLayout
                android:id="@+id/row_min_importance"
                style="@style/Widget.App.Row.WithSubtitle"
                android:background="@null"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_assistant_adv_min_importance" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/memory_assistant_adv_min_importance_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_min_importance_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="wrap_content" />
            </LinearLayout>

            <!-- ============ Associative Memory Prompt ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_assistant_adv_associative_prompt" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_assistant_adv_extraction_prompt_hint" />

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedDenseStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_extraction_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="8"
                    android:overScrollMode="always"
                    android:scrollbars="vertical" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_prompt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/memory_assistant_adv_reset_prompt" />

            <!-- ============ Lorebook Memory Prompt ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:layout_marginTop="20dp"
                android:text="@string/memory_assistant_adv_lorebook_prompt" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_assistant_adv_extraction_prompt_hint" />

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedDenseStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_lorebook_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="8"
                    android:overScrollMode="always"
                    android:scrollbars="vertical" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_lorebook_prompt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/memory_assistant_adv_reset_prompt" />

            <!-- ============ Save ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_save" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
