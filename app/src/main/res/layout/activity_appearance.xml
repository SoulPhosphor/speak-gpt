<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/appearance_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                style="@style/Widget.App.Screen.Intro"
                android:paddingTop="16dp"
                android:text="@string/appearance_subtitle" />

            <LinearLayout
                android:id="@+id/row_name_style"
                style="@style/Widget.App.Row.TitleOnly">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_id_card"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/name_style_title" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/name_style_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_chat_behavior"
                style="@style/Widget.App.Row.TitleOnly">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_forum"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_settings_tile_title" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/chat_settings_tile_title" />
            </LinearLayout>

            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/appearance_section_message_display" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_staggered_responses" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_staggered_responses_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_staggered_responses"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_profile_images" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_profile_images_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_profile_images"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_names" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_names_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_names"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_ai_bubble" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_ai_bubble_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_ai_bubble"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_user_bubble" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_user_bubble_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_user_bubble"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_model_names" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_model_names_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_model_names"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_token_usage" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_token_usage_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_token_usage"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_user_tokens" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_user_tokens_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_user_tokens"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_hardware_keyboard_shortcuts" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:maxLines="10" android:text="@string/appearance_hardware_keyboard_shortcuts_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_hardware_keyboard_shortcuts"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
