<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/model_parameters_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_save" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/Widget.App.ActionBar.SecondaryButton"
            android:contentDescription="@string/btn_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/btn_save"
            app:srcCompat="@drawable/ic_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- The model these parameters belong to. -->
            <TextView
                android:id="@+id/text_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:textColor="?attr/appTitleTextColor"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Streaming -->
            <LinearLayout style="@style/Widget.App.ParameterCard">

                <org.teslasoft.assistant.ui.widgets.ParameterSectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:parameterTitle="@string/streaming_title"
                    app:parameterInfo="@string/streaming_description" />

                <LinearLayout
                    android:id="@+id/row_streaming"
                    style="@style/Widget.App.CheckOption.Row"
                    android:layout_width="match_parent">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_streaming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false" />

                    <TextView
                        style="@style/Widget.App.CheckOption.Label"
                        android:text="@string/streaming_title" />
                </LinearLayout>
            </LinearLayout>

            <!-- Temperature -->
            <LinearLayout style="@style/Widget.App.ParameterCard">

                <org.teslasoft.assistant.ui.widgets.ParameterSectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:parameterTitle="@string/sampling_label_temperature"
                    app:parameterInfo="@string/sampling_hint_temperature" />

                <org.teslasoft.assistant.ui.widgets.SamplingParameterControl
                    android:id="@+id/temperature_slider"
                    style="@style/Widget.App.SamplingSlider.Container"
                    android:contentDescription="@string/set_temperature" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_deterministic"
                        android:textColor="?attr/appTextColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_creative"
                        android:textColor="?attr/appTextColor" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top P -->
            <LinearLayout style="@style/Widget.App.ParameterCard">

                <org.teslasoft.assistant.ui.widgets.ParameterSectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:parameterTitle="@string/sampling_label_top_p"
                    app:parameterInfo="@string/sampling_hint_top_p" />

                <org.teslasoft.assistant.ui.widgets.SamplingParameterControl
                    android:id="@+id/top_p_slider"
                    style="@style/Widget.App.SamplingSlider.Container"
                    android:contentDescription="@string/set_top_p" />
            </LinearLayout>

            <!-- Frequency penalty -->
            <LinearLayout style="@style/Widget.App.ParameterCard">

                <org.teslasoft.assistant.ui.widgets.ParameterSectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:parameterTitle="@string/sampling_label_frequency_penalty"
                    app:parameterInfo="@string/sampling_hint_frequency_penalty" />

                <org.teslasoft.assistant.ui.widgets.SamplingParameterControl
                    android:id="@+id/frequency_penalty_slider"
                    style="@style/Widget.App.SamplingSlider.Container"
                    android:contentDescription="@string/set_frequency_penalty" />
            </LinearLayout>

            <!-- Presence penalty -->
            <LinearLayout style="@style/Widget.App.ParameterCard">

                <org.teslasoft.assistant.ui.widgets.ParameterSectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:parameterTitle="@string/sampling_label_presence_penalty"
                    app:parameterInfo="@string/sampling_hint_presence_penalty" />

                <org.teslasoft.assistant.ui.widgets.SamplingParameterControl
                    android:id="@+id/presence_penalty_slider"
                    style="@style/Widget.App.SamplingSlider.Container"
                    android:contentDescription="@string/set_presence_penalty" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
