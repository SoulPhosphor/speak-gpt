<!--
  The anchored Message Details popup opened by the ⓘ message action
  (chat-redesign-plan.md §5). Bare values only — no heading and no field labels
  (owner ruling): a date/time, the model, and the token count, each self-evident
  and shown only when stored for this message. Every color resolves through a
  theme attribute (the rounded surface fill lives in @drawable/ui_dialog_rounded,
  text uses the shared appTextColor zone role), so a future palette or theme
  applies here without touching this layout. The empty line covers a message
  saved before any details were recorded. The box is as wide as its longest
  line plus its padding (owner ruling, Oct 9 2026); every visual value is in
  the Widget.App.MessageDetails.* styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.MessageDetails.Popup">

    <TextView
        android:id="@+id/details_value_datetime"
        style="@style/Widget.App.MessageDetails.FirstValue" />

    <TextView
        android:id="@+id/details_value_model"
        style="@style/Widget.App.MessageDetails.Value" />

    <TextView
        android:id="@+id/details_value_tokens"
        style="@style/Widget.App.MessageDetails.Value" />

    <!-- Provider-reported reasoning tokens, kept separate from answer tokens
         (chat-redesign-plan.md §7.8). Shown only when the provider reported a
         reasoning-token count for this reply. -->
    <TextView
        android:id="@+id/details_value_reasoning_tokens"
        style="@style/Widget.App.MessageDetails.Value" />

    <TextView
        android:id="@+id/details_empty"
        style="@style/Widget.App.MessageDetails.Empty"
        android:text="@string/message_details_empty" />
</LinearLayout>
