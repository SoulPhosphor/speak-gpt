<!--
  The anchored Message Details popup opened by the ⓘ message action
  (chat-redesign-plan.md §5). Bare values only — no heading and no field labels
  (owner ruling): a date/time, the model, and the token count, each self-evident
  and shown only when stored for this message. Every color resolves through a
  theme attribute (the rounded surface fill lives in @drawable/ui_dialog_rounded,
  text uses the shared appTextColor zone role), so a future palette or theme
  applies here without touching this layout. The empty line covers a message
  saved before any details were recorded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_dialog_rounded"
    android:minWidth="200dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/details_value_datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextColor"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/details_value_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/appTextColor"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/details_value_tokens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/appTextColor"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/details_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_details_empty"
        android:textColor="?attr/appSubtleTextColor"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
