<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_drawer_panel"
    style="@style/Widget.App.DrawerSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed top: app name, then Search, then the closing double-chevron.
         Search sits immediately to the left of the chevron (owner ruling,
         Sep 2 2026); it no longer occupies a row of its own. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drawer_brand"
            android:textColor="?attr/appTitleTextColor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/drawer_search"
            style="@style/Widget.App.ActionBar.BackButton"
            android:contentDescription="@string/search_title"
            android:src="@drawable/ic_search"
            android:tooltipText="@string/search_title"
            app:srcCompat="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/drawer_close"
            style="@style/Widget.App.ActionBar.BackButton"
            android:contentDescription="@string/drawer_close"
            android:src="@drawable/ic_drawer_close"
            android:tooltipText="@string/drawer_close"
            app:srcCompat="@drawable/ic_drawer_close" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_hierarchy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Only used with Lock Folder Location. The heading stays visible;
             expanded contents scroll independently within the half-height cap. -->
        <org.teslasoft.assistant.ui.drawer.LockedFoldersLayout
            android:id="@+id/drawer_folders_pinned"
            style="@style/Widget.App.DrawerSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/drawer_folders_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_folder_contents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </org.teslasoft.assistant.ui.drawer.LockedFoldersLayout>
    </FrameLayout>

    <!-- Fixed bottom: Settings, New Folder, New Chat, in that order. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/drawer_settings"
            style="@style/Widget.App.DrawerBottomAction"
            android:text="@string/btn_settings" />

        <TextView
            android:id="@+id/drawer_new_folder"
            style="@style/Widget.App.DrawerBottomAction"
            android:text="@string/drawer_new_folder" />

        <TextView
            android:id="@+id/drawer_new_chat"
            style="@style/Widget.App.DrawerBottomAction"
            android:text="@string/drawer_new_chat" />
    </LinearLayout>
</LinearLayout>
