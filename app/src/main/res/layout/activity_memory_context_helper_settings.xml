<!-- Memory Context Helper Settings (conversation_recall_plan.md G38, M.11;
     owner-approved wording, Stage 2). Built from shared styles only. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/title_memory_context_helper_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.Page.Content">

            <TextView
                style="@style/Widget.App.Screen.Intro.PageTop"
                android:text="@string/memory_context_helper_intro" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/memory_context_helper_toggle" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/memory_context_helper_toggle_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_memory_context_helper"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <!-- Shown while the helper is on: the Helper Method dropdown,
                 its explanation, and, for API AI, Number of Past Messages to
                 Send (conversation_recall_plan.md G38, M.4). -->
            <LinearLayout
                android:id="@+id/group_helper_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/Widget.App.Page.ControlRow">

                    <TextView
                        style="@style/Widget.App.Dropdown.CanonicalLabel"
                        android:text="@string/memory_context_helper_method" />

                    <TextView
                        android:id="@+id/dropdown_helper_method"
                        style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill"
                        android:text="@string/memory_context_helper_method_code_based" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_helper_method_hint"
                    style="@style/Widget.App.Section.Hint"
                    android:text="@string/memory_context_helper_method_code_based_hint" />

                <LinearLayout
                    android:id="@+id/row_helper_past_messages"
                    style="@style/Widget.App.Row.Number"
                    android:visibility="gone">

                    <LinearLayout style="@style/Widget.App.Row.TextColumn">

                        <TextView
                            style="@style/Widget.App.Row.Title"
                            android:text="@string/memory_context_helper_past_messages" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/field_helper_past_messages"
                        style="@style/Widget.App.Row.Number.Field"
                        android:ems="3"
                        android:importantForAutofill="no"
                        android:maxLength="3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
