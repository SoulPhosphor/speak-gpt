<?xml version="1.0" encoding="utf-8"?>
<!-- Chat Behaviors: simple screen header (back button and title) over a page
     of toggle rows. Appearance comes from the Widget.App.* styles only. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/chat_behaviors_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.Page.Content">

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_behaviors_allow_message_visibility" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/chat_behaviors_allow_message_visibility_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_allow_message_visibility"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_usage_alert_toggle" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_chat_usage_alert"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_usage_alert_amount_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Widget.App.Field.Label.AfterRow"
                    android:labelFor="@id/chat_usage_alert_amount"
                    android:text="@string/chat_usage_alert_amount_label" />
                <TextView
                    style="@style/Widget.App.Field.Hint"
                    android:text="@string/chat_usage_alert_amount_hint" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/chat_usage_alert_amount"
                    style="@style/Widget.App.Field.Box"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
