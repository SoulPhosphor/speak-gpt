<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/category_check"
            style="@style/Widget.App.CheckOption.CheckBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true" />

        <TextView
            android:id="@+id/category_mode"
            style="@style/Widget.App.Dropdown.CanonicalValue"
            android:layout_marginStart="8dp"
            android:text="@string/restore_mode_merge" />
    </LinearLayout>

    <TextView
        android:id="@+id/category_description"
        style="@style/Widget.App.Section.Hint"
        android:layout_marginStart="48dp"
        android:paddingTop="0dp" />

</merge>
