<!-- Shared Chat Signature Style section: a heading, the name exactly as chat
     styles it, and a button into Name Style. Driven by ChatSignatureSection.
     Hosts set only this include's width and placement. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Signature">

    <TextView
        style="@style/Widget.App.Section.Title"
        android:text="@string/chat_signature_style" />

    <TextView
        android:id="@+id/signature_preview"
        style="@style/Widget.App.Signature.Preview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/signature_change_style"
        style="@style/Widget.App.Signature.ChangeButton"
        android:text="@string/chat_signature_change_name_style" />
</LinearLayout>
