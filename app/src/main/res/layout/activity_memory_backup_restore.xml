<!-- App-wide Backup & Restore. Phase 11 visible order: Backup Status, Database
     Integrity, Backup (Automatic Backups, Recovery Backup, Human-Readable Chat
     Backup, temporary legacy converter), then Restore Data (portable category
     selection and direct database restore). Superseded one-purpose controls
     and Reset retain their wiring but are hidden on this page. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:layout_width="0dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/title_memory_backup_restore"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- ============ 1. Backup Status ============ -->
            <!-- Moved above Database Health (owner ruling, July 24 2026): this
                 is the one section that's always current on open, so the data
                 leads. Section heading style: Widget.App.Section.Title (see
                 values/themes.xml + ui-style-guide.md). -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_status_section" />

            <TextView android:id="@+id/text_status_memory" style="@style/Widget.App.BackupStatus.Row.First" />

            <!-- Per-database recovery actions (owner ruling, July 24 2026):
                 shown ONLY when this database is actually corrupted
                 (DatabaseHealthState.isDegraded), directly under its failed
                 status row, so the user can fix it here instead of waiting
                 for the one-shot A1 dialog. Gone by default; a backup that
                 failed for space/permission reasons never shows these — only
                 confirmed corruption does. Buttons wrap to their own text
                 (AppButton.Primary.Inline) so they sit side by side at
                 different widths. -->
            <LinearLayout
                android:id="@+id/health_actions_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/health_buttons_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_repair_memory"
                        style="@style/AppButton.Primary.Inline"
                        android:layout_marginEnd="8dp"
                        android:text="@string/health_btn_repair" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_revert_memory"
                        style="@style/AppButton.Primary.Inline"
                        android:text="@string/restore_database" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/health_progress_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/health_spinner_memory"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/health_progress_text_memory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/text_status_lorebooks" style="@style/Widget.App.BackupStatus.Row" />

            <LinearLayout
                android:id="@+id/health_actions_lorebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/health_buttons_lorebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_repair_lorebook"
                        style="@style/AppButton.Primary.Inline"
                        android:layout_marginEnd="8dp"
                        android:text="@string/health_btn_repair" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_revert_lorebook"
                        style="@style/AppButton.Primary.Inline"
                        android:text="@string/restore_database" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/health_progress_lorebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/health_spinner_lorebook"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/health_progress_text_lorebook"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/text_status_chats" style="@style/Widget.App.BackupStatus.Row" />

            <!-- Chats deliberately get NO recovery buttons here: chats are not
                 a database and never enter the repair/revert flow (the Round-4
                 chat-storage lock system owns that case). -->

            <TextView android:id="@+id/text_status_userimage" style="@style/Widget.App.BackupStatus.Row" />

            <LinearLayout
                android:id="@+id/health_actions_userimage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/health_buttons_userimage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_repair_userimage"
                        style="@style/AppButton.Primary.Inline"
                        android:layout_marginEnd="8dp"
                        android:text="@string/health_btn_repair" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_health_revert_userimage"
                        style="@style/AppButton.Primary.Inline"
                        android:text="@string/restore_database" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/health_progress_userimage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/health_spinner_userimage"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/health_progress_text_userimage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Space style="@style/Widget.App.BackupStatus.BlankLine" />
            <TextView style="@style/Widget.App.BackupStatus.Title"
                android:text="@string/backup_readable_history_title" />
            <LinearLayout android:id="@+id/readable_backup_history_rows"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Space style="@style/Widget.App.BackupStatus.BlankLine" />
            <TextView style="@style/Widget.App.BackupStatus.Title"
                android:text="@string/backup_database_checks_title" />
            <TextView android:id="@+id/text_last_database_test" style="@style/Widget.App.BackupStatus.Row" />
            <TextView android:id="@+id/text_database_test_memory" style="@style/Widget.App.BackupStatus.Row" />
            <TextView android:id="@+id/text_database_test_lorebook" style="@style/Widget.App.BackupStatus.Row" />
            <TextView android:id="@+id/text_database_test_userimage" style="@style/Widget.App.BackupStatus.Row" />

            <!-- ============ 2. Database Health ============ -->
            <!-- Section heading + hint styles: Widget.App.Section.Title/.Hint
                 (see values/themes.xml + ui-style-guide.md). The hint always
                 comes directly under the title and before the button it
                 explains - never after the button. -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_db_health_section" />
            <TextView android:id="@+id/text_databases_last_checked" style="@style/Widget.App.BackupStatus.Row" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/backup_check_integrity_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_integrity"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/backup_check_integrity" />

            <!-- §15.9 verbatim in-progress line: visible only while the check
                 runs, then replaced by the per-database result lines below. -->
            <TextView
                android:id="@+id/text_check_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/health_check_progress"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_result_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_result_lorebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_result_userimage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ============ 3. Backup ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_section_title" />

            <LinearLayout
                android:id="@+id/row_backup_options"
                style="@style/Widget.App.Row.TitleOnly">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/backup_options_title" />
                </LinearLayout>
                <ImageView style="@style/Widget.App.Row.Chevron" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_manual_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_manual_location"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/backup_change_location"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_backup"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/backup_create"
                android:visibility="gone" />

            <!-- ============ 5. Portable Data Copy ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/backup_portable_section"
                android:visibility="gone" />

            <!-- Two explanatory paragraphs, both directly under the title and
                 before either button (owner correction, July 22 2026): the
                 privacy warning used to sit below the buttons and the status
                 line, reading as if it described something else entirely. -->
            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/backup_portable_desc"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/backup_portable_warning"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_portable_export"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/backup_portable_export"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_portable_import"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/backup_portable_import"
                android:visibility="gone" />

            <!-- Temporary legacy conversion entry point. The conversion runs
                 on its own screen and is removed from every build after the
                 migration is complete. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_legacy_convert"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/legacy_convert_action"
                android:visibility="gone" />

            <!-- Persistent inline status for export/import results (replaces
                 the removed toasts). Stays until replaced. -->
            <TextView
                android:id="@+id/text_portable_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ============ 6. Companion & Roleplay Backup ============ -->
            <!-- Disaster recovery for companion and roleplay configuration
                 (companion-roleplay-backup-plan.md). One backup category, no
                 per-item selection; memories and lorebooks are deliberately
                 not included. Reuses this screen's established section,
                 button, progress and status-text styles. -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/companion_backup_section"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/companion_backup_desc"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_companion_download"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/companion_backup_download"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_companion_upload"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/companion_backup_upload"
                android:visibility="gone" />

            <!-- Rotating progress + label while working ("Backing up…" /
                 "Restoring…"), same pattern as the database-restore row. -->
            <LinearLayout
                android:id="@+id/companion_backup_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/companion_backup_spinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/companion_backup_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Persistent inline result (saved-to / restored) — stays until
                 replaced. Never a toast. -->
            <TextView
                android:id="@+id/text_companion_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ============ Restore Data ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/restore_data_section" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/restore_data_hint" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/restore_chat_always_newer" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:text="@string/restore_chat_always_newer_desc" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_restore_chat_always_newer"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/restore_chat_keep_both" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_restore_chat_keep_both"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_activation_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_profile_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_chats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_companions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_generated_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_glamours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_lorebooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_memories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_model_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/restore_model_credentials_note"
                style="@style/Widget.App.Section.Hint"
                android:layout_marginStart="48dp"
                android:paddingTop="4dp"
                android:text="@string/restore_model_credentials_note" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_model_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_roleplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.teslasoft.assistant.ui.views.RestoreCategoryView
                android:id="@+id/restore_category_system_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_portable_restore"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="true"
                android:text="@string/restore_from_backup" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.App.Dropdown.CanonicalLabel"
                    android:text="@string/restore_type_label" />

                <TextView
                    android:id="@+id/btn_restore_type"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_restore_database"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/restore_database" />

            <LinearLayout
                android:id="@+id/restore_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/restore_spinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/restore_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============ 8. Reset (destructive; bottom, unchanged) ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_controls_section_reset"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.App.Section.Hint"
                android:text="@string/memory_controls_reset_hint"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_memory_reset"
                style="@style/AppButton.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/memory_controls_reset"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
