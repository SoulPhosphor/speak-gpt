<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.ModelPicker.CatalogControls">

    <LinearLayout
        android:id="@+id/model_browser_profile_row"
        style="@style/Widget.App.ModelPicker.ControlRow">

        <TextView
            style="@style/Widget.App.Dropdown.CanonicalLabel"
            android:labelFor="@id/model_browser_profile"
            android:text="@string/model_browser_api_provider" />

        <TextView
            android:id="@+id/model_browser_profile"
            style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill" />
    </LinearLayout>

    <!-- One pill: the search scope dropdown, a divider, then the search
         field (Widget.App.SearchPill.*). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/model_browser_search_box"
        style="@style/Widget.App.SearchPill">

        <TextView
            android:id="@+id/model_browser_search_scope"
            style="@style/Widget.App.SearchPill.Scope"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/model_browser_search_divider"
            style="@style/Widget.App.SearchPill.Divider"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/model_browser_search_scope" />

        <ImageView
            android:id="@+id/model_browser_search_icon"
            style="@style/Widget.App.SearchPill.Icon"
            android:src="@drawable/ic_search"
            app:layout_constraintStart_toEndOf="@id/model_browser_search_divider"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/model_browser_search"
            style="@style/Widget.App.SearchPill.Field"
            android:hint="@string/label_search_models"
            android:inputType="text"
            android:imeOptions="actionSearch"
            app:layout_constraintStart_toEndOf="@id/model_browser_search_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <org.teslasoft.assistant.ui.widgets.SegmentedPill
        android:id="@+id/model_browser_filters"
        style="@style/Widget.App.ModelPicker.FilterPill">

        <TextView
            android:id="@+id/model_browser_all"
            style="@style/Widget.App.SegmentedPill.Option"
            android:text="@string/cat_all" />

        <TextView
            android:id="@+id/model_browser_new"
            style="@style/Widget.App.SegmentedPill.Option"
            android:text="@string/model_browser_new" />

        <TextView
            android:id="@+id/model_browser_free"
            style="@style/Widget.App.SegmentedPill.Option"
            android:text="@string/model_browser_free" />
    </org.teslasoft.assistant.ui.widgets.SegmentedPill>

    <LinearLayout
        android:id="@+id/model_browser_sort_row"
        style="@style/Widget.App.ModelPicker.ControlRow">

        <TextView
            style="@style/Widget.App.Dropdown.CanonicalLabel"
            android:labelFor="@id/model_browser_sort"
            android:text="@string/image_gallery_sort" />

        <TextView
            android:id="@+id/model_browser_sort"
            style="@style/Widget.App.Dropdown.CanonicalValue.Trailing.Fill" />
    </LinearLayout>
</LinearLayout>
