<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/action_bar" style="@style/Widget.App.ActionBar">
        <ImageButton android:id="@+id/btn_back" style="@style/Widget.App.ActionBar.BackButton" />
        <TextView android:id="@+id/activity_title" style="@style/Widget.App.ActionBar.Title"
            android:layout_width="0dp" android:layout_marginHorizontal="64dp" android:gravity="center"
            android:text="@string/tts_manager_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView android:id="@+id/tts_manager_scroll" android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/action_bar" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Widget.App.Dropdown.CanonicalLabel" android:text="@string/tts_manager_endpoint" />
                <TextView android:id="@+id/tts_endpoint" style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="16dp"
                    android:text="@string/tts_manager_select" />
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/tts_model_row"
                style="@style/Widget.App.Row.Selector" android:layout_marginTop="16dp"
                android:background="@null">
                <TextView android:id="@+id/tts_model_label" style="@style/Widget.App.Row.Selector.Label"
                    android:text="@string/tts_picker_ai_model" app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/tts_model_value" style="@style/Widget.App.Row.Selector.Value"
                    android:text="@string/tts_manager_select" app:layout_constraintStart_toEndOf="@id/tts_model_label"
                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView android:id="@+id/tts_provider_title" style="@style/Widget.App.Section.Title"
                android:text="@string/tts_manager_provider_title" />
            <TextView style="@style/Widget.App.Section.Hint" android:text="@string/tts_manager_provider_hint" />
            <LinearLayout android:id="@+id/tts_provider_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tts_routing_mode" style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:text="@string/choose_provider_routing_automatic" />
                <TextView android:id="@+id/tts_provider_value" style="@style/Widget.App.Row.Selector.Value"
                    android:layout_weight="1" android:minHeight="@dimen/tts_manager_action_height"
                    android:gravity="center_vertical|end" android:clickable="true" android:text="@string/tts_manager_select" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/tts_add_model"
                style="@style/AppButton.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/model_rule_edit_add_model" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/tts_manager_progress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/tts_selected_voice_models_title" style="@style/Widget.App.Section.Title"
                android:text="@string/tts_manager_selected_voice_models" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout android:id="@+id/tts_saved_table" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
