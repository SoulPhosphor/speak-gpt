<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup Attempts Failed pop-up actions (owner ruling, Oct 31 2026), beneath
  the dialog's message: Cancel then Retry as one right-aligned row of real
  buttons (Retry drops to the next line, still on the right, only when the
  row does not fit), then Change Backup Folder centered beneath it. Same
  composition as the Compaction error pop-up.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_backup_failed_cancel,btn_backup_failed_retry"
            app:flow_firstHorizontalBias="1"
            app:flow_horizontalBias="1"
            app:flow_horizontalGap="12dp"
            app:flow_horizontalStyle="packed"
            app:flow_lastHorizontalBias="1"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_failed_cancel"
            style="@style/AppButton.Destructive.Inline"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_failed_retry"
            style="@style/AppButton.Primary.Inline"
            android:text="@string/health_btn_retry" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_backup_failed_change_folder"
        style="@style/AppButton.Primary.Inline.Centered"
        android:layout_marginTop="8dp"
        android:text="@string/health_btn_change_folder" />
</LinearLayout>
