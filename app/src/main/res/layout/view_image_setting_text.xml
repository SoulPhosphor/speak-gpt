<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.App.ImageGeneration.SettingRow" android:orientation="vertical">
    <LinearLayout style="@style/Widget.App.ImageGeneration.InputRow">
        <TextView android:id="@+id/image_setting_label" style="@style/Widget.App.ImageGeneration.Label" />
        <FrameLayout style="@style/Widget.App.ImageGeneration.InputFrame">
            <EditText android:id="@+id/image_setting_input" style="@style/Widget.App.ImageGeneration.Input" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/image_setting_previous" style="@style/Widget.App.Row.Subtitle" android:visibility="gone" />
    <TextView android:id="@+id/image_setting_subtitle" style="@style/Widget.App.Row.Subtitle" android:visibility="gone" />
</LinearLayout>
