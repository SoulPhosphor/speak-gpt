<!-- Memory Context Helper Tool API (conversation_recall_plan.md M.4): the
     API context helper's own endpoint, model, provider routing and
     parameters, opened from AI Settings. Arranged as Memory Scanner Tool API
     with its shared components, as the owner authorized. Appearance comes
     only from shared styles (ui-style-guide.md). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/title_memory_context_helper_tool_api"
            app:layout_constraintEnd_toStartOf="@+id/btn_save" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/Widget.App.ActionBar.SaveButton"
            android:contentDescription="@string/btn_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/btn_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout style="@style/Widget.App.Page.Content">

            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/memory_context_helper_api_section_model" />

            <LinearLayout style="@style/Widget.App.StackedSelector">

                <TextView
                    style="@style/Widget.App.Row.Title"
                    android:text="@string/memory_context_helper_api_endpoint" />

                <TextView
                    style="@style/Widget.App.Row.Subtitle"
                    android:text="@string/memory_context_helper_api_endpoint_hint" />

                <LinearLayout style="@style/Widget.App.StackedSelector.ValueLine">

                    <TextView
                        android:id="@+id/text_helper_endpoint_value"
                        style="@style/Widget.App.StackedSelector.Value"
                        android:text="@string/dropdown_select" />

                    <ImageButton
                        android:id="@+id/btn_edit_helper_endpoint"
                        style="@style/Widget.App.StackedSelector.Gear"
                        android:contentDescription="@string/memory_assistant_edit_endpoint_desc"
                        android:tooltipText="@string/memory_assistant_edit_endpoint_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.StackedSelector">

                <TextView
                    style="@style/Widget.App.Row.Title"
                    android:text="@string/memory_context_helper_api_model" />

                <TextView
                    style="@style/Widget.App.Row.Subtitle"
                    android:text="@string/memory_context_helper_api_model_hint" />

                <TextView
                    android:id="@+id/text_helper_model_value"
                    style="@style/Widget.App.StackedSelector.Value.Full"
                    android:text="@string/dropdown_select" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_helper_models"
                    style="@style/Widget.App.StackedSelector.Action"
                    android:text="@string/choose_provider_view_all_models" />
            </LinearLayout>

            <!-- Provider routing: shown from code only for endpoints that
                 support it. -->
            <LinearLayout
                android:id="@+id/section_helper_routing"
                style="@style/Widget.App.StackedSelector.Group"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.App.Section.Title"
                    android:text="@string/memory_assistant_routing_title" />

                <TextView
                    style="@style/Widget.App.Section.Hint"
                    android:text="@string/memory_assistant_routing_hint" />

                <TextView
                    android:id="@+id/text_helper_routing_value"
                    style="@style/Widget.App.StackedSelector.Value.AfterHint"
                    android:text="@string/choose_provider_routing_automatic" />
            </LinearLayout>

            <!-- Every model parameter (shared block), saved with this
                 screen's Save. -->
            <include layout="@layout/view_dedicated_model_parameters" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_model_parameters"
                style="@style/Widget.App.PlainParameter.TextLink"
                android:text="@string/memory_assistant_adv_reset_temperature" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
