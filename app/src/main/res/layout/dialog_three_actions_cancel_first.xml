<?xml version="1.0" encoding="utf-8"?>
<!-- Shared readable three-action dialog. Exact visual/action order is top to
     bottom: cancel/back-out, alternate commitment, final commitment. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_cancel_action"
        style="@style/AppButton.Destructive.DialogStacked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_middle_action"
        style="@style/AppButton.Primary.DialogStacked"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_dialog_cancel_action" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_final_action"
        style="@style/AppButton.Destructive.DialogStacked"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_dialog_middle_action" />

</androidx.constraintlayout.widget.ConstraintLayout>
