<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/chat_settings_tile_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView style="@style/Widget.App.Section.Title"
                android:text="@string/chat_settings_section_appearance" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_profile_images" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_profile_images_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_profile_images"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_names" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_names_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_names"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_ai_bubble" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_ai_bubble_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_ai_bubble"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_user_bubble" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_user_bubble_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_user_bubble"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <TextView style="@style/Widget.App.Section.Title"
                android:text="@string/chat_settings_section_information" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_model_names" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_model_names_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_model_names"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_token_usage" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_token_usage_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_token_usage"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_user_tokens" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_user_tokens_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_user_tokens"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_settings_show_thinking" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_show_thinking"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_settings_thinking_indicator" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_thinking_indicator"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <TextView style="@style/Widget.App.Section.Title"
                android:text="@string/chat_settings_section_interface" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_staggered_responses" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_staggered_responses_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_staggered_responses"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_settings_top_positioned_audio_control" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_top_positioned_audio_control"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/appearance_hardware_keyboard_shortcuts" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/appearance_hardware_keyboard_shortcuts_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_hardware_keyboard_shortcuts"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <TextView style="@style/Widget.App.Section.Title.BeforeField"
                android:text="@string/chat_behavior_section_identity" />

            <TextView
                style="@style/Widget.App.Field.Label"
                android:text="@string/chat_behavior_default_username" />

            <TextView
                style="@style/Widget.App.Field.Hint"
                android:text="@string/chat_behavior_default_username_hint" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView style="@style/Widget.App.Row.Title" android:text="@string/chat_behavior_apply_previous_chats" />
                    <TextView style="@style/Widget.App.Row.Subtitle" android:text="@string/chat_behavior_apply_previous_chats_hint" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_apply_previous_chats"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/field_default_username"
                style="@style/Widget.App.Field.Box"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true" />

            <LinearLayout style="@style/Widget.App.Row.Toggle">
                <LinearLayout style="@style/Widget.App.Row.TextColumn">
                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_behavior_roleplay_names_replace_glamour" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_roleplay_names_replace_glamour"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rebuild_search_index"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/search_rebuild" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
