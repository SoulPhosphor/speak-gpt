<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expandable_window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/expandable_window_background_24"
    android:transitionName="chat_expand">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bulk_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSecondaryContainer"
            android:clickable="true"
            android:elevation="3dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_select_all"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent_tonal_v6"
                android:contentDescription="Select all"
                android:src="@drawable/ic_select_all"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_select_all" />

            <ImageButton
                android:id="@+id/btn_deselect_all"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent_tonal_v6"
                android:contentDescription="Deselect all"
                android:src="@drawable/ic_deselect_all"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_select_all"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_deselect_all" />

            <ImageButton
                android:id="@+id/btn_share_selected"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent_tonal_v6"
                android:contentDescription="Share selected"
                android:src="@drawable/ic_share"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/btn_copy_selected"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent_tonal_v6"
                android:contentDescription="Copy selected"
                android:src="@drawable/ic_copy_normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_share_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_copy_normal" />

            <ImageButton
                android:id="@+id/btn_delete_selected"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent_tonal_v6"
                android:contentDescription="Delete selected"
                android:src="@drawable/ic_delete"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_copy_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_delete" />

            <TextView
                android:id="@+id/text_selected_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="0"
                android:textColor="@color/text_title"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_deselect_all"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/thread_loader"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/progressBar5"
                style="@style/Widget.Material3.LoadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorSize="72dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyboard_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:elevation="6dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/keyboard_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

<!-- Primary action button (rightmost). Doubles as the hands-free CONVERSATION
                     control and the SEND control: it shows the conversation waveform while the
                     input box is empty (tap engages/stops hands-free) and switches to the
                     upward-arrow send glyph while there is text (tap sends). The field is still
                     called btnSend in code. Default icon is the waveform; the text watcher and
                     click wiring that flip it live are added in the behavior phase. -->
                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/btn_accent_tonal_v5"
                    android:contentDescription="@string/btn_send"
                    android:src="@drawable/ic_conversation"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/message_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="76dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="128dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="message"
                    android:background="@drawable/btn_accent_tonal_selector_v6"
                    android:ems="10"
                    android:hint="@string/hint_message"
                    android:inputType="text|textMultiLine|textCapSentences"
                    android:isScrollContainer="true"
                    android:maxHeight="120dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="13dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="13dp"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    style="@style/Widget.Material3.CircularProgressIndicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/assistant_clear_v2"
                    android:elevation="0.02dip"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

<!-- Single-turn transcription button. Sits immediately LEFT of the primary
                     conversation/send button; both stay in the bar together. Anchored to the
                     start edge of btn_send so the two never overlap. -->
                <ImageButton
                    android:id="@+id/btn_micro"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/btn_accent_tonal_v5"
                    android:clickable="true"
                    android:contentDescription="@string/btn_speak"
                    android:elevation="0.01dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_send"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_microphone" />

                <ImageButton
                    android:id="@+id/btn_attach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/btn_accent_tonal_v5"
                    android:contentDescription="@string/btn_attach"
                    android:src="@drawable/ic_attach"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_attach" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/btn_settings"
                android:tooltipText="@string/btn_settings"
                android:transitionName="settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btn_quick_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/btn_quick_settings"
                android:tooltipText="@string/btn_quick_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_settings"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_history_edu" />

            <!-- Shown only while audio/VAD diagnostics are on (see
                 ChatActivity.updateDebugLogButtonVisibility); a one-tap jump
                 from the chat to the Event log so the user can see what the
                 voice pipeline is logging without digging through Settings. -->
            <ImageButton
                android:id="@+id/btn_debug_log"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/btn_open_event_log"
                android:tooltipText="@string/btn_open_event_log"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_quick_settings"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_bug"
                tools:visibility="visible" />

            <!-- Summary view (decision 11): visible only while the
                 summarizer is on for this chat. -->
            <ImageButton
                android:id="@+id/btn_summary"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/summarizer_icon_summary_desc"
                android:tooltipText="@string/summarizer_icon_summary_desc"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_debug_log"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_subject"
                tools:visibility="visible" />

            <!-- Summarizer Errors (decision 16): first in the icon row,
                 visible while this chat's error log has entries. The badge
                 shows the stored-error count (1–5). -->
            <ImageButton
                android:id="@+id/btn_summarizer_errors"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/summarizer_icon_errors_desc"
                android:tooltipText="@string/summarizer_icon_errors_desc"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_summary"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_data_alert"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/summarizer_error_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_summarizer_badge"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/btn_summarizer_errors"
                app:layout_constraintTop_toTopOf="@+id/btn_summarizer_errors"
                tools:text="3"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_accent_tonal_v4"
                android:contentDescription="@string/go_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_back" />

            <TextView
                android:id="@+id/chat_activity_title"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="debug.chat.name"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_summarizer_errors"
                app:layout_constraintStart_toEndOf="@+id/btn_back"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Database Health A2 banner (§15.2a): persistent, dismissible,
             re-shown per new chat while a database stays disabled. GONE by
             default, so the messages list sits exactly where it always did;
             when visible it pushes the list down instead of covering it. -->
        <LinearLayout
            android:id="@+id/health_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_bar"
            tools:visibility="visible">

            <TextView
                android:id="@+id/health_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="14sp"
                tools:text="@string/health_banner_memory" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/health_banner_ok"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_banner_btn_ok" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/health_banner_repair"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health_btn_repair" />
            </LinearLayout>
        </LinearLayout>

        <!-- Height is 0dp (match-constraint), NOT match_parent: match_parent
             ignores constraints inside ConstraintLayout (the old 64dp top
             margin existed to hand-compensate for the 64dp action bar). With
             real constraints the list starts under the A2 banner when it is
             visible and exactly under the action bar when it is gone — same
             position as before. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:contentDescription="@string/menu_chat"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="80dp"
            android:scrollbars="none"
            android:stackFromBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/health_banner"
            tools:listitem="@layout/view_assistant_bot_message" />

<!-- Pending Includes strip: one row per unsent document, directly above the
             message box. Sent attachments leave this surface and appear in
             the transcript under the user name.

             Rows are inflated into include_list from view_include_row.xml; at
             four or more items include_collapsed takes over instead and the
             list becomes a tap-to-expand overlay (see IncludeStripController).
             It floats over the chat like the attachment preview beside it —
             the RecyclerView is bottom-anchored to the parent with padding, so
             nothing here shifts the conversation around. -->
        <LinearLayout
            android:id="@+id/include_strip"
            style="@style/Widget.App.Include.Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:elevation="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/keyboard_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/include_document_hint"
                style="@style/Widget.App.Include.Notice"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:text="@string/include_document_pending_hint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/include_image_hint"
                style="@style/Widget.App.Include.Notice"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:text="@string/include_image_pending_hint"
                android:visibility="gone" />

<!-- No android:id here on purpose: an id on an <include> REPLACES the
                 included layout's own root id, which would make
                 findViewById(R.id.include_collapsed_row) return null. -->
            <include layout="@layout/view_include_collapsed" />

            <ScrollView
                android:id="@+id/include_list_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/include_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vision_action_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/include_strip"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <!-- Paperclip popup: a vertical stack of labeled actions. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0dp">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/attach_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:blurOverlayColor="@color/blur_background">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <LinearLayout
                            android:id="@+id/action_camera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_camera"
                                android:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingEnd="8dp"
                                android:text="@string/btn_camera"
                                android:textColor="@color/text"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/action_gallery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_image"
                                android:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingEnd="8dp"
                                android:text="@string/attach_option_image"
                                android:textColor="@color/text"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/action_document"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_file"
                                android:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingEnd="8dp"
                                android:text="@string/btn_attach_document"
                                android:textColor="@color/text"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Pre-existing hidden legacy action. -->
                        <ImageButton
                            android:id="@+id/action_sources"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_accent_50_v2"
                            android:contentDescription="@string/label_select_from_gallery"
                            android:src="@drawable/ic_book"
                            android:tooltipText="Data Sources"
