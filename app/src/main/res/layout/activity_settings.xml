<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expandable_window"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="right"
    android:background="@drawable/expandable_window_background"
    android:orientation="vertical"
    android:transitionName="settings">

    <LinearLayout
        android:id="@+id/thread_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/progressBar4"
            style="@style/Widget.Material3.LoadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorSize="72dp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="right">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_bar"
            style="@style/Widget.App.ActionBar">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/Widget.App.ActionBar.BackButton" />

            <TextView
                android:id="@+id/activity_new_settings_title"
                style="@style/Widget.App.ActionBar.Title"
                android:text="@string/title_control_center" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_bar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scrollable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:paddingBottom="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <!-- Row-style conversion review slice (owner request, July 18
                     2026): General's four navigation entries are the
                     reference implementation for the new leading-icon row
                     (Widget.App.Row.Icon, combined with the existing
                     Widget.App.Row.WithSubtitle). Icons are the same
                     drawables already used here before conversion. -->
                <LinearLayout
                    android:id="@+id/tile_characters"
                    style="@style/Widget.App.Row.WithSubtitle"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        style="@style/Widget.App.Row.Icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_user"
                        android:tint="?attr/colorPrimary" />

                    <LinearLayout style="@style/Widget.App.Row.TextColumn">

                        <TextView
                            style="@style/Widget.App.Row.Title"
                            android:text="@string/tile_characters_title" />

                        <TextView
                            style="@style/Widget.App.Row.Subtitle"
                            android:maxLines="3"
                            android:text="@string/tile_characters_desc" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.App.Row.Chevron"
                        android:contentDescription="@string/tile_characters_title" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/tile_ai_system_settings"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout8">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_ai_system_settings_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_ai_system_settings_desc" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_ai_system_settings_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_memory_system"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_ai_system_settings">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_storage"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_memory_system_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_memory_system_desc" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_memory_system_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_roleplay"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_memory_system">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_book"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_roleplay_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_roleplay_desc" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_roleplay_title" />
            </LinearLayout>

            <!-- Profile Image Properties (profile-images-plan.md ADDENDUM,
                 Phase 6): a row, not a tile - "tiles are being slowly hunted
                 to extinction" (owner ruling, July 19 2026). Same
                 WithSubtitle + Icon pattern as the four rows above it. -->
            <LinearLayout
                android:id="@+id/tile_profile_image_properties"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_roleplay">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_photo"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_profile_image_properties_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_profile_image_properties_desc" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_profile_image_properties_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_images"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_voice_settings">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_images_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_images_desc" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_images_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_voice_settings"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_profile_image_properties">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_voice"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_voice_settings_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_voice_settings_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_voice_settings_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_appearance"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_images">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/appearance_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/appearance_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/appearance_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_chat_settings"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_appearance">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/chat_settings_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/chat_settings_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/chat_settings_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_about_app"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_log_cabin">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_about_app_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_about_app_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_about_app_title" />
            </LinearLayout>

            <!-- The upstream fork's "Clear chat" row (erase messages, keep
                 the chat) was removed by owner ruling, July 29 2026: deleting
                 the chat is the only content-removal action. -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_about_app">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tile_documentation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/tile_alert_debug_menu"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_chat_settings">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bug"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_alert_debug_menu_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_alert_debug_menu_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_alert_debug_menu_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_log_cabin"
                style="@style/Widget.App.Row.WithSubtitle"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tile_alert_debug_menu">

                <ImageView
                    style="@style/Widget.App.Row.Icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cabin"
                    android:tint="?attr/colorPrimary" />

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/tile_log_cabin_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/tile_log_cabin_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/tile_log_cabin_title" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
