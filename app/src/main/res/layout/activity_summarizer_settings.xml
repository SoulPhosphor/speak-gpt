<!-- Summarizer Settings (conversation-summary-plan.md decision 2): Summary
     Model endpoint/model pickers, the Complete Messages default, the
     new-chats toggle, Summary Length, and the Customize Prompt Summaries row
     that opens Summarizer Prompts. Composed from the shared style families
     only. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title"
            android:text="@string/title_summarizer_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- No-model state explanation (decision 8, owner-authored). -->
            <TextView
                style="@style/Widget.App.Screen.Intro"
                android:paddingTop="16dp"
                android:text="@string/summarizer_intro" />

            <!-- ============ Use Summarizer for New Chats ============ -->
            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/summarizer_new_chats_toggle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_summarizer_new_chats"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <!-- ============ Always Resummarize Changed Sections ============ -->
            <LinearLayout style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/summarizer_always_resummarize_toggle" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/summarizer_always_resummarize_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_summarizer_always_resummarize"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>

            <!-- ============ Summary Length ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Widget.App.Field.Label"
                        android:text="@string/summarizer_length" />

                    <TextView
                        style="@style/Widget.App.Field.Hint"
                        android:text="@string/summarizer_length_hint" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_summary_length"
                    style="@style/Widget.App.Field.NumberBlank"
                    android:ems="5"
                    android:maxLength="5"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- ============ Complete Messages (default for new chats) ============
                 NumberBlank belongs inline with its label (its own style
                 contract, matched by every other use in the app) — the
                 label/hint sit in a text column beside it, the same shape as
                 Widget.App.Row.WithSubtitle's TextColumn but paired with a
                 NumberBlank instead of a Dropdown.Value. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        style="@style/Widget.App.Field.Label"
                        android:text="@string/summarizer_complete_messages" />

                    <TextView
                        style="@style/Widget.App.Field.Hint"
                        android:text="@string/summarizer_complete_messages_hint" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/field_complete_messages"
                    style="@style/Widget.App.Field.NumberBlank"
                    android:ems="4"
                    android:maxLength="4"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- ============ Summary Model ============ -->
            <TextView
                style="@style/Widget.App.Section.Title"
                android:text="@string/summarizer_section_model" />

            <LinearLayout
                android:id="@+id/row_summarizer_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/summarizer_row_endpoint" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/summarizer_row_endpoint_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_summarizer_endpoint_value"
                        style="@style/Widget.App.Dropdown.CanonicalValue"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/dropdown_select" />

                    <ImageButton
                        android:id="@+id/btn_edit_summarizer_endpoint"
                        style="@style/Widget.App.QuickTile.EditButton"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="0dp"
                        android:contentDescription="@string/summarizer_edit_endpoint_desc"
                        android:src="@drawable/ic_settings"
                        android:tooltipText="@string/summarizer_edit_endpoint_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_summarizer_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/summarizer_row_model" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="10"
                        android:text="@string/summarizer_row_model_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_summarizer_model_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/dropdown_select" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_summarizer_models"
                    style="@style/AppButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_provider_view_all_models" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_summarizer_routing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.App.Section.Title"
                    android:text="@string/summarizer_routing_title" />

                <TextView
                    style="@style/Widget.App.Section.Hint"
                    android:text="@string/summarizer_routing_hint" />

                <TextView
                    android:id="@+id/text_summarizer_routing_value"
                    style="@style/Widget.App.Dropdown.CanonicalValue"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_provider_routing_automatic" />
            </LinearLayout>

            <!-- ============ Customize Prompt Summaries ============
                 Opens Summarizer Prompts (owner ruling, Oct 3 2026). -->
            <LinearLayout
                android:id="@+id/row_summarizer_prompts"
                style="@style/Widget.App.Row.WithSubtitle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/summarizer_prompts_row_title" />

                    <TextView
                        style="@style/Widget.App.Row.Subtitle"
                        android:maxLines="3"
                        android:text="@string/summarizer_prompts_row_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.App.Row.Chevron"
                    android:contentDescription="@string/summarizer_prompts_row_title" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
