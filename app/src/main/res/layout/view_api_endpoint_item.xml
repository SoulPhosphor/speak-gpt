<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui"
    style="@style/Widget.App.Row.WithSubtitle"
    android:paddingHorizontal="20dp">

    <LinearLayout style="@style/Widget.App.Row.TextColumn">

        <TextView
            android:id="@+id/endpoint_label"
            style="@style/Widget.App.Row.Title"
            android:ellipsize="end"
            android:lines="1"
            android:text="OpenAI" />

        <TextView
            android:id="@+id/endpoint_host"
            style="@style/Widget.App.Row.Subtitle"
            android:layout_marginTop="2dp"
            android:text="https://api.openai.com/api/v1/" />
    </LinearLayout>

    <ImageView
        style="@style/Widget.App.Row.Chevron"
        android:contentDescription="@string/label_edit_api_endpoint" />
</LinearLayout>
