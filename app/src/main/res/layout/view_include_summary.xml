<?xml version="1.0" encoding="utf-8"?>
<!--
  The full-document "Includes" record inside a sent chat message: a small box
  under the user's name that opens like an accordion.

  Condensed items move to the bookmark-with-plus marker. Fully removed sent
  items move to the empty bookmark marker. Both markers open editable text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/include_summary"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/include_summary_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_field_box"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/include_summary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/include_label"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/include_summary_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/include_expand_desc"
            android:src="@drawable/ic_chevron_down"
            android:tint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/include_summary_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />
</LinearLayout>
