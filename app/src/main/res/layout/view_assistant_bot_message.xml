<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ui"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingTop="@dimen/chat_message_leading_spacing"
    android:paddingBottom="@dimen/chat_message_unit_spacing">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_message_speaker_inset"
        android:layout_marginEnd="@dimen/chat_message_ai_right_inset"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bubble_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chat_portrait_vertical_offset"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bubble_in"
            android:padding="@dimen/chat_message_content_padding">

            <!-- Speaker name shown INSIDE the bubble for the no-portrait cases,
                 so it stays attached when the bubble is centered for an image
                 (owner ask, Aug 15 2026). GONE when a portrait is shown (the
                 row-level @id/username sits beside the portrait instead). -->
            <TextView
                android:id="@+id/bubble_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/chat_name_body_gap"
                android:textColor="?attr/colorPrimary"
                android:textSize="21sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Compact per-message metadata (chat-redesign-plan.md §4.3): the
                 producing model and/or provider token count, each gated by its
                 own Appearance toggle and shown only when that turn actually
                 carries the value. Sits beneath the identity line, above the
                 reply. GONE (a zero-height point) whenever nothing is enabled or
                 available, so the reply keeps its original position. Its color is
                 set in code to the bubble foreground so it follows the theme. -->
            <TextView
                android:id="@+id/message_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bubble_name" />

            <org.teslasoft.assistant.ui.chat.PortraitAwareMessageTextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="50dp"
                android:tag="ai"
                android:textColor="?attr/colorPrimary"
                android:textIsSelectable="true"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message_meta" />

            <LinearLayout
                android:id="@+id/image_frame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message">

                <ImageView
                    android:id="@+id/generated_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:descendantFocusability="blocksDescendants"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/assistant" />

                <LinearLayout
                    android:id="@+id/generated_image_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/image_gen_loading_result"
                        android:textColor="?attr/appTextColor" />
                </LinearLayout>

                <TextView
                    android:id="@+id/generated_image_error"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/image_gen_load_failed"
                    android:textColor="?attr/appTextColor"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/generated_image_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_image_prompt"
                        style="@style/AppButton.Primary.Inline"
                        android:text="@string/image_gen_prompt_action"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_image_download"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/image_gen_save_action"
                        android:src="@drawable/ic_download"
                        android:tooltipText="@string/image_gen_save_action"
                        android:visibility="gone" />

                    <!-- For a generated image the Share and Copy actions sit on
                         this same row as Prompt and Download, instead of on the
                         separate action bar below (owner ask, Aug 14 2026). The
                         action-bar Share/Copy are hidden for images; these
                         delegate to them so the behavior is identical. -->
                    <ImageButton
                        android:id="@+id/btn_image_share"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Share message"
                        android:src="@drawable/ic_share"
                        android:tooltipText="Share message"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_image_copy"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_copy"
                        android:src="@drawable/ic_copy"
                        android:tooltipText="@string/btn_copy"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/status_marker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_frame" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/status_marker">

                <ImageButton
                    android:id="@+id/btn_details"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="@string/message_details_action"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_info"
                    android:tooltipText="@string/message_details_action"
                    app:srcCompat="@drawable/ic_info" />

                <ImageButton
                    android:id="@+id/btn_speak"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_speak"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_volume_up"
                    android:tooltipText="@string/btn_msg_speak"
                    app:srcCompat="@drawable/ic_volume_up" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:contentDescription="Share message"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_share"
                    android:tooltipText="Share message"
                    app:layout_constraintEnd_toStartOf="@+id/btn_retry"
                    app:layout_constraintTop_toTopOf="@+id/username"
                    app:srcCompat="@drawable/ic_share" />

                <ImageButton
                    android:id="@+id/btn_retry"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_retry"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_retry"
                    android:tooltipText="@string/btn_msg_retry"
                    app:srcCompat="@drawable/ic_retry" />

                <ImageButton
                    android:id="@+id/btn_copy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_copy"
                    android:descendantFocusability="blocksDescendants"
                    android:tooltipText="@string/btn_copy"
                    app:srcCompat="@drawable/ic_copy" />

                <ImageButton
                    android:id="@+id/btn_edit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/btn_msg_edit"
                    android:descendantFocusability="blocksDescendants"
                    android:src="@drawable/ic_edit"
                    android:tooltipText="@string/btn_msg_edit"
                    app:srcCompat="@drawable/ic_edit" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_name_portrait_edge_inset"
        android:layout_marginTop="@dimen/chat_name_portrait_top"
        android:text="@string/chat_role_assistant"
        android:textColor="?attr/colorPrimary"
        android:textSize="21sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Declared last so the 96dp portrait stays above the overlapping bubble,
         matching the tuner's portrait z-index. -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/chat_portrait_size"
        android:layout_height="@dimen/chat_portrait_size"
        android:layout_marginStart="@dimen/chat_portrait_edge_inset"
        android:layout_marginTop="@dimen/chat_portrait_top_offset"
        android:background="@drawable/btn_accent_tonal"
        android:clickable="false"
        android:contentDescription="@null"
        android:padding="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />

</androidx.constraintlayout.widget.ConstraintLayout>
