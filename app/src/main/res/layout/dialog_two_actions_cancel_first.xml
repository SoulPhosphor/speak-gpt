<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable centered two-action dialog row whose approved order is the
  cancel/back-out action first, followed by the affirmative action.

  The order is independent of semantic style: the first button is
  AppButton.Destructive.DialogAction and the second is
  AppButton.Primary.DialogAction. Use this layout only when the feature
  wording/spec approves this order; do not reverse the actions to fit the
  primary-first dialog layout.

  The packed chain centers the pair as one group. Horizontal/bottom padding
  keeps the buttons clear of the dialog window's rounded lower edge.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_destructive_action"
        style="@style/AppButton.Destructive.DialogAction"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_dialog_primary_action"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_primary_action"
        style="@style/AppButton.Primary.DialogAction"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_dialog_destructive_action"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
