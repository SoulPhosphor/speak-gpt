<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/expandable_window_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">
        <ImageButton android:id="@+id/btn_back" style="@style/Widget.App.ActionBar.BackButton" />
        <TextView style="@style/Widget.App.ActionBar.Title" android:text="@string/voice_browser_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/voice_browser_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/Widget.App.Dropdown.CanonicalLabel"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:text="@string/voice_browser_provider" />
        <TextView
            android:id="@+id/provider_dropdown"
            style="@style/Widget.App.Dropdown.CanonicalValue"
            android:layout_width="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/location_segments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:checkedButton="@id/location_all"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/location_all" style="@style/Widget.App.VoiceBrowser.Segment" android:text="@string/voice_browser_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/location_device" style="@style/Widget.App.VoiceBrowser.Segment" android:text="@string/voice_browser_on_device" />
            <com.google.android.material.button.MaterialButton android:id="@+id/location_network" style="@style/Widget.App.VoiceBrowser.Segment" android:text="@string/voice_browser_network" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/filter_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical" />

        <TextView
            style="@style/Widget.App.Field.Label"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:text="@string/voice_browser_preview_text" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/voice_preview_text"
            style="@style/Widget.App.Field.Box"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:isScrollContainer="true"
            android:maxLines="6"
            android:minLines="3"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical" />

        <TextView
            style="@style/Widget.App.Section.Hint"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:paddingTop="0dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:text="@string/voice_browser_long_press_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/Widget.App.Section.Title"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/voice_browser_voices" />
            <TextView
                android:id="@+id/voice_count"
                style="@style/Widget.App.Row.Subtitle"
                android:layout_width="wrap_content"
                android:textAlignment="viewEnd" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="240dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/voices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="24dp" />
            <LinearLayout
                android:id="@+id/voice_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="240dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">
                <com.google.android.material.loadingindicator.LoadingIndicator
                    android:id="@+id/voice_loading"
                    style="@style/Widget.Material3.LoadingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="56dp" />
                <TextView
                    android:id="@+id/voice_state_message"
                    style="@style/Widget.App.Section.Hint"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_filters"
                    style="@style/AppButton.Primary.Inline"
                    android:layout_marginTop="12dp"
                    android:text="@string/voice_browser_reset_filters"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
