<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        style="@style/Widget.App.ActionBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.App.ActionBar.BackButton" />

        <TextView
            android:id="@+id/activity_title"
            style="@style/Widget.App.ActionBar.Title.NearBack"
            android:text="@string/reasoning_settings_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_save" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/Widget.App.ActionBar.SecondaryButton"
            android:contentDescription="@string/btn_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/btn_save"
            app:srcCompat="@drawable/ic_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Thinking: reasoning-effort level for this favorite (§7.4). A
                 clickable row that opens a dropdown of the levels the active
                 model/provider supports (plus Auto, and Off when disable is
                 supported). GONE when the combination exposes no configurable
                 effort - a reasoning model can still show Show Reasoning below. -->
            <LinearLayout
                android:id="@+id/row_thinking"
                style="@style/Widget.App.Row.Toggle"
                android:background="?attr/selectableItemBackground">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/reasoning_thinking_label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_thinking_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="?attr/appTextColor"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Show Reasoning: request/display provider reasoning (§7.4). Never
                 disables the model's reasoning. GONE when the combination cannot
                 return user-visible reasoning. -->
            <LinearLayout
                android:id="@+id/row_show_reasoning"
                style="@style/Widget.App.Row.Toggle">

                <LinearLayout style="@style/Widget.App.Row.TextColumn">

                    <TextView
                        style="@style/Widget.App.Row.Title"
                        android:text="@string/reasoning_show_reasoning_label" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_show_reasoning"
                    style="@style/Widget.App.Row.Switch" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
