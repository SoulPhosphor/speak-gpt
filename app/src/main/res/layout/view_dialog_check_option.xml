<?xml version="1.0" encoding="utf-8"?>
<!-- Shared checkbox line placed beneath a dialog's action buttons
     (for example "Do not show this warning for the rest of this session"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.CheckOption.Row.Dialog">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/check_dialog_option"
        style="@style/Widget.App.CheckOption.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
